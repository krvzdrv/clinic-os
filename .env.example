# Подключение к БД. Если переменная не задана — используется локальный SQLite (clinic.db).
# Для Supabase: возьмите Direct connection string из Project Settings → Database.
# Формат: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# (используйте pooler-адрес на порту 6543 — он держит соединения, обычный 5432 режет их).
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres

# Flask
FLASK_ENV=development
