        <bpmndi:BPMNLabel>
          <dc:Bounds x="55" y="224" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="I_Adm" bpmnElement="SubProcess_Admission">
        <dc:Bounds x="170" y="150" width="180" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="I_Icu" bpmnElement="SubProcess_IcuDecision">
