        <di:waypoint x="116" y="200" />
        <di:waypoint x="170" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="IE2" bpmnElement="Flow_Top_Admit_To_Icu">
        <di:waypoint x="350" y="200" />
        <di:waypoint x="420" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="IE3" bpmnElement="Flow_Top_Icu_To_Therapy">
        <di:waypoint x="600" y="200" />
        <di:waypoint x="620" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="IE3b" bpmnElement="Flow_Top_To_IvTherapy">
        <di:waypoint x="670" y="200" />
