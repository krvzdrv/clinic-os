        <di:waypoint x="420" y="310" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Icu">
    <bpmndi:BPMNPlane id="BPMNPlane_Icu" bpmnElement="SubProcess_IcuDecision">
      <bpmndi:BPMNShape id="C_S" bpmnElement="Start_Icu">
        <dc:Bounds x="80" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_A" bpmnElement="Task_AssessSeverityIcu">
        <dc:Bounds x="160" y="160" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_G" bpmnElement="Gateway_Icu" isMarkerVisible="true">
        <dc:Bounds x="390" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="278.0" y="186.5" width="100.0" height="27.0" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_N" bpmnElement="Task_NoteIcu">
        <dc:Bounds x="480" y="40" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_M" bpmnElement="Gateway_IcuMerge" isMarkerVisible="true">
        <dc:Bounds x="700" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_E" bpmnElement="End_Icu">
        <dc:Bounds x="810" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="780" y="224" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_A27" bpmnElement="Annotation_P27">
        <dc:Bounds x="300" y="8" width="100" height="28" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Ce1" bpmnElement="Flow_c1">
        <di:waypoint x="116" y="200" />
        <di:waypoint x="160" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ce2" bpmnElement="Flow_c2">
        <di:waypoint x="330" y="200" />
        <di:waypoint x="390" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ce3" bpmnElement="Flow_c3">
        <di:waypoint x="415" y="175" />
        <di:waypoint x="415" y="80" />
        <di:waypoint x="480" y="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="429.0" y="120.5" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ce4" bpmnElement="Flow_c4">
        <di:waypoint x="440" y="200" />
        <di:waypoint x="700" y="200" />
        <bpmndi:BPMNLabel>
