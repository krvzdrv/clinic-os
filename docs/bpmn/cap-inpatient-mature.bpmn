<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_cap_inpatient"
                  targetNamespace="http://clinic-os/processes/cap_inpatient"
                  exporter="clinic-os"
                  exporterVersion="3">
  <!-- Layout: happy path слева→направо; симптом. ветка вниз от госпитализации; петли «нет» снизу. -->
  <bpmn:process id="cap_inpatient" name="Стационарное лечение внебольничной пневмонии (КП №768)" isExecutable="false">
    <bpmn:startEvent id="Start_HospDecision" name="Старт: госпитализация">
      <bpmn:outgoing>Flow_i1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Admit" name="Госпитализация">
      <bpmn:incoming>Flow_i1</bpmn:incoming>
      <bpmn:outgoing>Flow_i2</bpmn:outgoing>
      <bpmn:outgoing>Flow_i8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AdmissionDiagnostics" name="Обследование при поступлении">
      <bpmn:incoming>Flow_i2</bpmn:incoming>
      <bpmn:outgoing>Flow_i3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PrescribeSymptomaticInpatient" name="Симптоматическая терапия">
      <bpmn:incoming>Flow_i8</bpmn:incoming>
      <bpmn:outgoing>Flow_i8b</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_SymptomaticOngoing" name="Продолжается на протяжении госпитализации">
      <bpmn:incoming>Flow_i8b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_AssessSeverityIcu" name="Оценка показаний к ОРИТ">
      <bpmn:incoming>Flow_i3</bpmn:incoming>
      <bpmn:outgoing>Flow_i4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Icu" name="ОРИТ?" default="Flow_i6">
      <bpmn:incoming>Flow_i4</bpmn:incoming>
      <bpmn:outgoing>Flow_i5</bpmn:outgoing>
      <bpmn:outgoing>Flow_i6</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_SelectRegimen" name="Выбор режима АБТ">
      <bpmn:incoming>Flow_i5</bpmn:incoming>
      <bpmn:incoming>Flow_i6</bpmn:incoming>
      <bpmn:incoming>Flow_i11</bpmn:incoming>
      <bpmn:outgoing>Flow_i7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PrescribeIvAbt" name="Антибактериальная терапия в/в">
      <bpmn:incoming>Flow_i7</bpmn:incoming>
      <bpmn:outgoing>Flow_i9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ReassessInpatient" name="Оценка эффекта терапии">
      <bpmn:incoming>Flow_i9</bpmn:incoming>
      <bpmn:outgoing>Flow_i10</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_AbtEffect_in" name="Есть эффект?" default="Flow_i12">
      <bpmn:incoming>Flow_i10</bpmn:incoming>
      <bpmn:outgoing>Flow_i11</bpmn:outgoing>
      <bpmn:outgoing>Flow_i12</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_StepDown" name="Переход на терапию внутрь">
      <bpmn:incoming>Flow_i12</bpmn:incoming>
      <bpmn:incoming>Flow_i15</bpmn:incoming>
      <bpmn:outgoing>Flow_i13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_EvaluateDischarge" name="Оценка готовности к выписке">
      <bpmn:incoming>Flow_i13</bpmn:incoming>
      <bpmn:outgoing>Flow_i14</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Discharge" name="К выписке?" default="Flow_i15">
      <bpmn:incoming>Flow_i14</bpmn:incoming>
      <bpmn:outgoing>Flow_i15</bpmn:outgoing>
      <bpmn:outgoing>Flow_i16</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_Discharge" name="Выписка">
      <bpmn:incoming>Flow_i16</bpmn:incoming>
      <bpmn:outgoing>Flow_i17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PostDischargeFollowup" name="Контроль после выписки">
      <bpmn:incoming>Flow_i17</bpmn:incoming>
      <bpmn:outgoing>Flow_i18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_HandoffOutpatient" name="На амбулаторный контроль">
      <bpmn:incoming>Flow_i18</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:textAnnotation id="Annotation_P27">
      <bpmn:text>КП №768, п.27</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_P27" sourceRef="Gateway_Icu" targetRef="Annotation_P27"/>
    <bpmn:textAnnotation id="Annotation_P30">
      <bpmn:text>КП №768, п.15 / п.30</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_P30" sourceRef="Gateway_AbtEffect_in" targetRef="Annotation_P30"/>
    <bpmn:textAnnotation id="Annotation_P49">
      <bpmn:text>КП №768, п.49</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_P49" sourceRef="Gateway_Discharge" targetRef="Annotation_P49"/>
    <bpmn:textAnnotation id="Annotation_Version">
      <bpmn:text>Версия: 2026-07-25. Бизнес-процесс (не инструкция). Сверка с КП №768 — через YAML и аннотации у шлюзов.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Version" sourceRef="Start_HospDecision" targetRef="Annotation_Version"/>

    <bpmn:sequenceFlow id="Flow_i1" sourceRef="Start_HospDecision" targetRef="Task_Admit"/>
    <bpmn:sequenceFlow id="Flow_i2" sourceRef="Task_Admit" targetRef="Task_AdmissionDiagnostics"/>
    <bpmn:sequenceFlow id="Flow_i3" sourceRef="Task_AdmissionDiagnostics" targetRef="Task_AssessSeverityIcu"/>
    <bpmn:sequenceFlow id="Flow_i4" sourceRef="Task_AssessSeverityIcu" targetRef="Gateway_Icu"/>
    <bpmn:sequenceFlow id="Flow_i5" name="да" sourceRef="Gateway_Icu" targetRef="Task_SelectRegimen"/>
    <bpmn:sequenceFlow id="Flow_i6" name="нет" sourceRef="Gateway_Icu" targetRef="Task_SelectRegimen"/>
    <bpmn:sequenceFlow id="Flow_i7" sourceRef="Task_SelectRegimen" targetRef="Task_PrescribeIvAbt"/>
    <bpmn:sequenceFlow id="Flow_i8" sourceRef="Task_Admit" targetRef="Task_PrescribeSymptomaticInpatient"/>
    <bpmn:sequenceFlow id="Flow_i8b" sourceRef="Task_PrescribeSymptomaticInpatient" targetRef="End_SymptomaticOngoing"/>
    <bpmn:sequenceFlow id="Flow_i9" sourceRef="Task_PrescribeIvAbt" targetRef="Task_ReassessInpatient"/>
    <bpmn:sequenceFlow id="Flow_i10" sourceRef="Task_ReassessInpatient" targetRef="Gateway_AbtEffect_in"/>
    <bpmn:sequenceFlow id="Flow_i11" name="нет" sourceRef="Gateway_AbtEffect_in" targetRef="Task_SelectRegimen"/>
    <bpmn:sequenceFlow id="Flow_i12" name="да" sourceRef="Gateway_AbtEffect_in" targetRef="Task_StepDown"/>
    <bpmn:sequenceFlow id="Flow_i13" sourceRef="Task_StepDown" targetRef="Task_EvaluateDischarge"/>
    <bpmn:sequenceFlow id="Flow_i14" sourceRef="Task_EvaluateDischarge" targetRef="Gateway_Discharge"/>
    <bpmn:sequenceFlow id="Flow_i15" name="нет" sourceRef="Gateway_Discharge" targetRef="Task_StepDown"/>
    <bpmn:sequenceFlow id="Flow_i16" name="да" sourceRef="Gateway_Discharge" targetRef="Task_Discharge"/>
    <bpmn:sequenceFlow id="Flow_i17" sourceRef="Task_Discharge" targetRef="Task_PostDischargeFollowup"/>
    <bpmn:sequenceFlow id="Flow_i18" sourceRef="Task_PostDischargeFollowup" targetRef="End_HandoffOutpatient"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_in">
    <bpmndi:BPMNPlane id="BPMNPlane_in" bpmnElement="cap_inpatient">
      <bpmndi:BPMNShape id="Shape_Start_in" bpmnElement="Start_HospDecision">
        <dc:Bounds x="100" y="202" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="72" y="245" width="92" height="40"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Admit" bpmnElement="Task_Admit">
        <dc:Bounds x="170" y="180" width="130" height="80"/>
      </bpmndi:BPMNShape>
      <!-- параллельная ветка вниз — не пересекает happy path -->
      <bpmndi:BPMNShape id="Shape_SympIn" bpmnElement="Task_PrescribeSymptomaticInpatient">
        <dc:Bounds x="160" y="320" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndSympIn" bpmnElement="End_SymptomaticOngoing">
        <dc:Bounds x="352" y="342" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="300" y="385" width="140" height="40"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_AdmitDx" bpmnElement="Task_AdmissionDiagnostics">
        <dc:Bounds x="340" y="180" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SevIcu" bpmnElement="Task_AssessSeverityIcu">
        <dc:Bounds x="550" y="180" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GwIcu" bpmnElement="Gateway_Icu" isMarkerVisible="true">
        <dc:Bounds x="750" y="195" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="748" y="252" width="54" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SelReg" bpmnElement="Task_SelectRegimen">
        <dc:Bounds x="860" y="180" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_IvAbt" bpmnElement="Task_PrescribeIvAbt">
        <dc:Bounds x="1040" y="180" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ReassessIn" bpmnElement="Task_ReassessInpatient">
        <dc:Bounds x="1240" y="180" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GwAbtIn" bpmnElement="Gateway_AbtEffect_in" isMarkerVisible="true">
        <dc:Bounds x="1430" y="195" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1408" y="252" width="94" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StepDown" bpmnElement="Task_StepDown">
        <dc:Bounds x="1520" y="180" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EvalDc" bpmnElement="Task_EvaluateDischarge">
        <dc:Bounds x="1720" y="180" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GwDc" bpmnElement="Gateway_Discharge" isMarkerVisible="true">
        <dc:Bounds x="1920" y="195" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1900" y="252" width="90" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Discharge" bpmnElement="Task_Discharge">
        <dc:Bounds x="2010" y="180" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_PostFu" bpmnElement="Task_PostDischargeFollowup">
        <dc:Bounds x="2170" y="180" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndOut" bpmnElement="End_HandoffOutpatient">
        <dc:Bounds x="2380" y="202" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="2340" y="245" width="116" height="40"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Ann_P27" bpmnElement="Annotation_P27">
        <dc:Bounds x="720" y="90" width="110" height="30"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Ann_P30" bpmnElement="Annotation_P30">
        <dc:Bounds x="1400" y="90" width="130" height="30"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Ann_P49" bpmnElement="Annotation_P49">
        <dc:Bounds x="1890" y="90" width="110" height="30"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Ann_in" bpmnElement="Annotation_Version">
        <dc:Bounds x="100" y="20" width="320" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Assoc_P27" bpmnElement="Assoc_P27">
        <di:waypoint x="775" y="195"/><di:waypoint x="775" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Assoc_P30" bpmnElement="Assoc_P30">
        <di:waypoint x="1455" y="195"/><di:waypoint x="1455" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Assoc_P49" bpmnElement="Assoc_P49">
        <di:waypoint x="1945" y="195"/><di:waypoint x="1945" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Ann_in" bpmnElement="Assoc_Version">
        <di:waypoint x="118" y="202"/><di:waypoint x="118" y="70"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_i1" bpmnElement="Flow_i1">
        <di:waypoint x="136" y="220"/><di:waypoint x="170" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_i2" bpmnElement="Flow_i2">
        <di:waypoint x="300" y="220"/><di:waypoint x="340" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_i8" bpmnElement="Flow_i8">
        <di:waypoint x="235" y="260"/><di:waypoint x="235" y="320"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_i8b" bpmnElement="Flow_i8b">
        <di:waypoint x="310" y="360"/><di:waypoint x="352" y="360"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_i3" bpmnElement="Flow_i3">
        <di:waypoint x="510" y="220"/><di:waypoint x="550" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_i4" bpmnElement="Flow_i4">
        <di:waypoint x="710" y="220"/><di:waypoint x="750" y="220"/>
      </bpmndi:BPMNEdge>
      <!-- да — прямо по линии -->
      <bpmndi:BPMNEdge id="Edge_i5" bpmnElement="Flow_i5">
        <di:waypoint x="800" y="220"/><di:waypoint x="860" y="220"/>
        <bpmndi:BPMNLabel><dc:Bounds x="818" y="198" width="14" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <!-- нет — лёгкий обход снизу, вход в ту же задачу -->
      <bpmndi:BPMNEdge id="Edge_i6" bpmnElement="Flow_i6">
        <di:waypoint x="775" y="245"/>
        <di:waypoint x="775" y="290"/>
        <di:waypoint x="930" y="290"/>
        <di:waypoint x="930" y="260"/>
        <bpmndi:BPMNLabel><dc:Bounds x="838" y="268" width="20" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_i7" bpmnElement="Flow_i7">
        <di:waypoint x="1000" y="220"/><di:waypoint x="1040" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_i9" bpmnElement="Flow_i9">
        <di:waypoint x="1200" y="220"/><di:waypoint x="1240" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_i10" bpmnElement="Flow_i10">
        <di:waypoint x="1390" y="220"/><di:waypoint x="1430" y="220"/>
      </bpmndi:BPMNEdge>
      <!-- нет эффекта → коридор y=360 → к выбору режима -->
      <bpmndi:BPMNEdge id="Edge_i11" bpmnElement="Flow_i11">
        <di:waypoint x="1455" y="245"/>
        <di:waypoint x="1455" y="360"/>
        <di:waypoint x="930" y="360"/>
        <di:waypoint x="930" y="260"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1170" y="338" width="20" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_i12" bpmnElement="Flow_i12">
        <di:waypoint x="1480" y="220"/><di:waypoint x="1520" y="220"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1488" y="198" width="14" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_i13" bpmnElement="Flow_i13">
        <di:waypoint x="1680" y="220"/><di:waypoint x="1720" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_i14" bpmnElement="Flow_i14">
        <di:waypoint x="1880" y="220"/><di:waypoint x="1920" y="220"/>
      </bpmndi:BPMNEdge>
      <!-- не к выписке → коридор y=420 → к step-down -->
      <bpmndi:BPMNEdge id="Edge_i15" bpmnElement="Flow_i15">
        <di:waypoint x="1945" y="245"/>
        <di:waypoint x="1945" y="420"/>
        <di:waypoint x="1600" y="420"/>
        <di:waypoint x="1600" y="260"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1750" y="398" width="20" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_i16" bpmnElement="Flow_i16">
        <di:waypoint x="1970" y="220"/><di:waypoint x="2010" y="220"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1978" y="198" width="14" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_i17" bpmnElement="Flow_i17">
        <di:waypoint x="2130" y="220"/><di:waypoint x="2170" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_i18" bpmnElement="Flow_i18">
        <di:waypoint x="2330" y="220"/><di:waypoint x="2380" y="220"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
