<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_cap_inpatient" targetNamespace="http://clinic-os/processes/cap_inpatient" exporter="Camunda Modeler" exporterVersion="5.46.1">
  <bpmn:error id="Error_NoIvEffect" name="Нет эффекта терапии" errorCode="NO_IV_EFFECT" />
  <bpmn:error id="Error_NotReadyDischarge" name="Пока не к выписке" errorCode="NOT_READY_DISCHARGE" />

  <bpmn:process id="cap_inpatient" name="Протокольная карта стационар (КП №768) — не путь ведения" isExecutable="false">
    <bpmn:startEvent id="Start_HospDecision" name="Госпитализация">
      <bpmn:outgoing>Flow_Top_Start_Admit</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:subProcess id="SubProcess_Admission" name="Поступление">
      <bpmn:incoming>Flow_Top_Start_Admit</bpmn:incoming>
      <bpmn:outgoing>Flow_Top_Admit_To_Icu</bpmn:outgoing>
      <bpmn:startEvent id="Start_Admission" name="Начало"><bpmn:outgoing>Flow_a1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Task_Admit" name="Госпитализация"><bpmn:incoming>Flow_a1</bpmn:incoming><bpmn:outgoing>Flow_a2</bpmn:outgoing><bpmn:outgoing>Flow_a2s</bpmn:outgoing></bpmn:task>
      <bpmn:task id="Task_AdmissionDiagnostics" name="Обследование при поступлении"><bpmn:incoming>Flow_a2</bpmn:incoming><bpmn:outgoing>Flow_a3</bpmn:outgoing></bpmn:task>
      <bpmn:task id="Task_PrescribeSymptomaticInpatient" name="Симптоматическая терапия"><bpmn:incoming>Flow_a2s</bpmn:incoming><bpmn:outgoing>Flow_a2se</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="End_SymptomaticOngoing" name="Симптоматика продолжается"><bpmn:incoming>Flow_a2se</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="End_Admission" name="Поступление оформлено"><bpmn:incoming>Flow_a3</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_a1" sourceRef="Start_Admission" targetRef="Task_Admit" />
      <bpmn:sequenceFlow id="Flow_a2" sourceRef="Task_Admit" targetRef="Task_AdmissionDiagnostics" />
      <bpmn:sequenceFlow id="Flow_a2s" sourceRef="Task_Admit" targetRef="Task_PrescribeSymptomaticInpatient" />
      <bpmn:sequenceFlow id="Flow_a2se" sourceRef="Task_PrescribeSymptomaticInpatient" targetRef="End_SymptomaticOngoing" />
      <bpmn:sequenceFlow id="Flow_a3" sourceRef="Task_AdmissionDiagnostics" targetRef="End_Admission" />
    </bpmn:subProcess>

    <bpmn:subProcess id="SubProcess_IcuDecision" name="Тяжесть и ОРИТ">
      <bpmn:incoming>Flow_Top_Admit_To_Icu</bpmn:incoming>
      <bpmn:outgoing>Flow_Top_Icu_To_Therapy</bpmn:outgoing>
      <bpmn:startEvent id="Start_Icu" name="Начало"><bpmn:outgoing>Flow_c1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Task_AssessSeverityIcu" name="Оценка показаний к ОРИТ"><bpmn:incoming>Flow_c1</bpmn:incoming><bpmn:outgoing>Flow_c2</bpmn:outgoing></bpmn:task>
      <bpmn:exclusiveGateway id="Gateway_Icu" name="Нужен ОРИТ?">
        <bpmn:incoming>Flow_c2</bpmn:incoming>
        <bpmn:outgoing>Flow_c3</bpmn:outgoing>
        <bpmn:outgoing>Flow_c4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="Task_NoteIcu" name="Перевод в ОРИТ"><bpmn:incoming>Flow_c3</bpmn:incoming><bpmn:outgoing>Flow_c5</bpmn:outgoing></bpmn:task>
      <bpmn:exclusiveGateway id="Gateway_IcuMerge" name="">
        <bpmn:incoming>Flow_c4</bpmn:incoming>
        <bpmn:incoming>Flow_c5</bpmn:incoming>
        <bpmn:outgoing>Flow_c6</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="End_Icu" name="Решение принято"><bpmn:incoming>Flow_c6</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_c1" sourceRef="Start_Icu" targetRef="Task_AssessSeverityIcu" />
      <bpmn:sequenceFlow id="Flow_c2" sourceRef="Task_AssessSeverityIcu" targetRef="Gateway_Icu" />
      <bpmn:sequenceFlow id="Flow_c3" name="да" sourceRef="Gateway_Icu" targetRef="Task_NoteIcu" />
      <bpmn:sequenceFlow id="Flow_c4" name="нет" sourceRef="Gateway_Icu" targetRef="Gateway_IcuMerge" />
      <bpmn:sequenceFlow id="Flow_c5" sourceRef="Task_NoteIcu" targetRef="Gateway_IcuMerge" />
      <bpmn:sequenceFlow id="Flow_c6" sourceRef="Gateway_IcuMerge" targetRef="End_Icu" />
      <bpmn:textAnnotation id="Annotation_P27"><bpmn:text>КП №768, п.27</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_P27" sourceRef="Gateway_Icu" targetRef="Annotation_P27" />
    </bpmn:subProcess>

    <bpmn:exclusiveGateway id="Gateway_IvTherapyEntry" name="">
      <bpmn:incoming>Flow_Top_Icu_To_Therapy</bpmn:incoming>
      <bpmn:incoming>Flow_Top_Escalate_To_Therapy</bpmn:incoming>
      <bpmn:outgoing>Flow_Top_To_IvTherapy</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SubProcess_IvTherapy" name="Лечение в стационаре">
      <bpmn:incoming>Flow_Top_To_IvTherapy</bpmn:incoming>
      <bpmn:outgoing>Flow_Top_Therapy_To_Discharge</bpmn:outgoing>
      <bpmn:startEvent id="Start_Iv" name="Начало"><bpmn:outgoing>Flow_v1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Task_SelectRegimen" name="Выбор схемы лечения"><bpmn:incoming>Flow_v1</bpmn:incoming><bpmn:outgoing>Flow_v2</bpmn:outgoing></bpmn:task>
      <bpmn:task id="Task_PrescribeIvAbt" name="Антибактериальная терапия внутривенно"><bpmn:incoming>Flow_v2</bpmn:incoming><bpmn:outgoing>Flow_v3</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="End_Iv" name="Лечение начато"><bpmn:incoming>Flow_v3</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_v1" sourceRef="Start_Iv" targetRef="Task_SelectRegimen" />
      <bpmn:sequenceFlow id="Flow_v2" sourceRef="Task_SelectRegimen" targetRef="Task_PrescribeIvAbt" />
      <bpmn:sequenceFlow id="Flow_v3" sourceRef="Task_PrescribeIvAbt" targetRef="End_Iv" />
    </bpmn:subProcess>

    <bpmn:subProcess id="SubProcess_DischargePath" name="Оценка и выписка">
      <bpmn:incoming>Flow_Top_Therapy_To_Discharge</bpmn:incoming>
      <bpmn:outgoing>Flow_Top_Discharge_Ok</bpmn:outgoing>
      <bpmn:startEvent id="Start_Dc" name="Начало"><bpmn:outgoing>Flow_d1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Task_ReassessInpatient" name="Оценка эффекта терапии"><bpmn:incoming>Flow_d1</bpmn:incoming><bpmn:outgoing>Flow_d2</bpmn:outgoing></bpmn:task>
      <bpmn:exclusiveGateway id="Gateway_AbtEffect_in" name="Есть эффект?">
        <bpmn:incoming>Flow_d2</bpmn:incoming>
        <bpmn:outgoing>Flow_d3</bpmn:outgoing>
        <bpmn:outgoing>Flow_d4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="End_Dc_NoEffect" name="Нет эффекта терапии">
        <bpmn:incoming>Flow_d3</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrDef_NoIv" errorRef="Error_NoIvEffect" />
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="Gateway_StepDownMerge" name="">
        <bpmn:incoming>Flow_d4</bpmn:incoming>
        <bpmn:incoming>Flow_d7</bpmn:incoming>
        <bpmn:outgoing>Flow_d4m</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="Task_StepDown" name="Переход на терапию внутрь"><bpmn:incoming>Flow_d4m</bpmn:incoming><bpmn:outgoing>Flow_d5</bpmn:outgoing></bpmn:task>
      <bpmn:task id="Task_EvaluateDischarge" name="Оценка готовности к выписке"><bpmn:incoming>Flow_d5</bpmn:incoming><bpmn:outgoing>Flow_d6</bpmn:outgoing></bpmn:task>
      <bpmn:exclusiveGateway id="Gateway_Discharge" name="К выписке?">
        <bpmn:incoming>Flow_d6</bpmn:incoming>
        <bpmn:outgoing>Flow_d7</bpmn:outgoing>
        <bpmn:outgoing>Flow_d8</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="Task_Discharge" name="Выписка"><bpmn:incoming>Flow_d8</bpmn:incoming><bpmn:outgoing>Flow_d9</bpmn:outgoing></bpmn:task>
      <bpmn:task id="Task_PostDischargeFollowup" name="Контроль после выписки"><bpmn:incoming>Flow_d9</bpmn:incoming><bpmn:outgoing>Flow_d10</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="End_Dc_Ok" name="Готово к амбулаторному контролю"><bpmn:incoming>Flow_d10</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_d1" sourceRef="Start_Dc" targetRef="Task_ReassessInpatient" />
      <bpmn:sequenceFlow id="Flow_d2" sourceRef="Task_ReassessInpatient" targetRef="Gateway_AbtEffect_in" />
      <bpmn:sequenceFlow id="Flow_d3" name="нет" sourceRef="Gateway_AbtEffect_in" targetRef="End_Dc_NoEffect" />
      <bpmn:sequenceFlow id="Flow_d4" name="да" sourceRef="Gateway_AbtEffect_in" targetRef="Gateway_StepDownMerge" />
      <bpmn:sequenceFlow id="Flow_d4m" sourceRef="Gateway_StepDownMerge" targetRef="Task_StepDown" />
      <bpmn:sequenceFlow id="Flow_d5" sourceRef="Task_StepDown" targetRef="Task_EvaluateDischarge" />
      <bpmn:sequenceFlow id="Flow_d6" sourceRef="Task_EvaluateDischarge" targetRef="Gateway_Discharge" />
      <bpmn:sequenceFlow id="Flow_d7" name="нет" sourceRef="Gateway_Discharge" targetRef="Gateway_StepDownMerge" />
      <bpmn:sequenceFlow id="Flow_d8" name="да" sourceRef="Gateway_Discharge" targetRef="Task_Discharge" />
      <bpmn:sequenceFlow id="Flow_d9" sourceRef="Task_Discharge" targetRef="Task_PostDischargeFollowup" />
      <bpmn:sequenceFlow id="Flow_d10" sourceRef="Task_PostDischargeFollowup" targetRef="End_Dc_Ok" />
      <bpmn:textAnnotation id="Annotation_P30"><bpmn:text>КП №768, п.15 / п.30</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_P30" sourceRef="Gateway_AbtEffect_in" targetRef="Annotation_P30" />
      <bpmn:textAnnotation id="Annotation_P49"><bpmn:text>КП №768, п.49</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_P49" sourceRef="Gateway_Discharge" targetRef="Annotation_P49" />
    </bpmn:subProcess>

    <bpmn:boundaryEvent id="Boundary_NoIvEffect" name="Нет эффекта" attachedToRef="SubProcess_DischargePath">
      <bpmn:outgoing>Flow_Top_Escalate_To_Therapy</bpmn:outgoing>
      <bpmn:errorEventDefinition id="BoundErr_NoIv" errorRef="Error_NoIvEffect" />
    </bpmn:boundaryEvent>

    <bpmn:endEvent id="End_HandoffOutpatient" name="На амбулаторный контроль"><bpmn:incoming>Flow_Top_Discharge_Ok</bpmn:incoming></bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Top_Start_Admit" sourceRef="Start_HospDecision" targetRef="SubProcess_Admission" />
    <bpmn:sequenceFlow id="Flow_Top_Admit_To_Icu" sourceRef="SubProcess_Admission" targetRef="SubProcess_IcuDecision" />
    <bpmn:sequenceFlow id="Flow_Top_Icu_To_Therapy" sourceRef="SubProcess_IcuDecision" targetRef="Gateway_IvTherapyEntry" />
    <bpmn:sequenceFlow id="Flow_Top_To_IvTherapy" sourceRef="Gateway_IvTherapyEntry" targetRef="SubProcess_IvTherapy" />
    <bpmn:sequenceFlow id="Flow_Top_Therapy_To_Discharge" sourceRef="SubProcess_IvTherapy" targetRef="SubProcess_DischargePath" />
    <bpmn:sequenceFlow id="Flow_Top_Discharge_Ok" sourceRef="SubProcess_DischargePath" targetRef="End_HandoffOutpatient" />
    <bpmn:sequenceFlow id="Flow_Top_Escalate_To_Therapy" sourceRef="Boundary_NoIvEffect" targetRef="Gateway_IvTherapyEntry" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_in">
    <bpmndi:BPMNPlane id="BPMNPlane_in" bpmnElement="cap_inpatient">
      <bpmndi:BPMNShape id="I_Start" bpmnElement="Start_HospDecision">
