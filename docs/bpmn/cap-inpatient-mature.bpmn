      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Admission">
    <bpmndi:BPMNPlane id="BPMNPlane_Admission" bpmnElement="SubProcess_Admission">
      <bpmndi:BPMNShape id="A_S" bpmnElement="Start_Admission">
        <dc:Bounds x="80" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_T" bpmnElement="Task_Admit">
        <dc:Bounds x="160" y="160" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_D" bpmnElement="Task_AdmissionDiagnostics">
