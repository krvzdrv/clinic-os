<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_cap_outpatient" targetNamespace="http://clinic-os/processes/cap_outpatient" exporter="Camunda Modeler" exporterVersion="5.46.1">
  <bpmn:error id="Error_NoAbtEffect" name="Нет эффекта терапии" errorCode="NO_ABT_EFFECT" />
  <bpmn:error id="Error_AdjustTherapy" name="Скорректировать лечение" errorCode="ADJUST_THERAPY" />
  <bpmn:process id="cap_outpatient" name="Амбулаторное лечение внебольничной пневмонии (КП №768)" isExecutable="false">
    <bpmn:startEvent id="Start_Complaint" name="Обращение">
      <bpmn:outgoing>Flow_Top_Start_Primary</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="SubProcess_PrimaryVisit" name="Провести первичный приём">
      <bpmn:incoming>Flow_Top_Start_Primary</bpmn:incoming>
      <bpmn:outgoing>Flow_Top_Primary_To_Hosp</bpmn:outgoing>
      <bpmn:startEvent id="Start_Primary" name="Начало">
        <bpmn:outgoing>Flow_p1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Task_Intake" name="Принять обращение">
        <bpmn:incoming>Flow_p1</bpmn:incoming>
        <bpmn:outgoing>Flow_p2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Task_VitalsExam" name="Провести осмотр">
        <bpmn:incoming>Flow_p2</bpmn:incoming>
        <bpmn:outgoing>Flow_p3</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Task_SetDiagnosis" name="Поставить диагноз ВП">
        <bpmn:incoming>Flow_p3</bpmn:incoming>
        <bpmn:outgoing>Flow_p4</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Task_AssessSeverity" name="Оценить тяжесть">
        <bpmn:incoming>Flow_p4</bpmn:incoming>
        <bpmn:outgoing>Flow_p5</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="End_Primary" name="Решение о месте лечения возможно">
        <bpmn:incoming>Flow_p5</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_p1" sourceRef="Start_Primary" targetRef="Task_Intake" />
      <bpmn:sequenceFlow id="Flow_p2" sourceRef="Task_Intake" targetRef="Task_VitalsExam" />
      <bpmn:sequenceFlow id="Flow_p3" sourceRef="Task_VitalsExam" targetRef="Task_SetDiagnosis" />
      <bpmn:sequenceFlow id="Flow_p4" sourceRef="Task_SetDiagnosis" targetRef="Task_AssessSeverity" />
      <bpmn:sequenceFlow id="Flow_p5" sourceRef="Task_AssessSeverity" targetRef="End_Primary" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gateway_Hospitalization" name="Нужна госпитализация?">
      <bpmn:incoming>Flow_Top_Primary_To_Hosp</bpmn:incoming>
      <bpmn:outgoing>Flow_Top_Hosp_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Top_Hosp_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_HospitalMerge" name="">
      <bpmn:incoming>Flow_Top_Hosp_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_Top_NoEffect_Hospital</bpmn:incoming>
      <bpmn:outgoing>Flow_Top_To_Hospital_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Hospitalized" name="Направить в стационар">
      <bpmn:incoming>Flow_Top_To_Hospital_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_TherapyEntry" name="">
      <bpmn:incoming>Flow_Top_Hosp_No</bpmn:incoming>
      <bpmn:incoming>Flow_Top_Adjust_To_Therapy</bpmn:incoming>
      <bpmn:incoming>Flow_Top_NoEffect_Retreatment</bpmn:incoming>
      <bpmn:outgoing>Flow_Top_To_Therapy</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SubProcess_Therapy" name="Обследовать и назначить лечение">
      <bpmn:incoming>Flow_Top_To_Therapy</bpmn:incoming>
      <bpmn:outgoing>Flow_Top_Therapy_To_Followup</bpmn:outgoing>
      <bpmn:startEvent id="Start_Therapy" name="Начало">
        <bpmn:outgoing>Flow_t1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Task_OrderDiagnostics" name="Назначить обследования">
        <bpmn:incoming>Flow_t1</bpmn:incoming>
        <bpmn:outgoing>Flow_t2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Task_RecordResults" name="Зафиксировать результаты">
        <bpmn:incoming>Flow_t2</bpmn:incoming>
        <bpmn:outgoing>Flow_t3</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Task_PrescribeAbt" name="Назначить антибактериальную терапию">
        <bpmn:incoming>Flow_t3</bpmn:incoming>
        <bpmn:outgoing>Flow_t4</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Task_PrescribeSymptomatic" name="Назначить симптоматическую терапию">
        <bpmn:incoming>Flow_t4</bpmn:incoming>
        <bpmn:outgoing>Flow_t5</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Task_CreateCarePlan" name="Составить план лечения">
        <bpmn:incoming>Flow_t5</bpmn:incoming>
        <bpmn:outgoing>Flow_t6</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="End_Therapy" name="Лечение назначено">
        <bpmn:incoming>Flow_t6</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_t1" sourceRef="Start_Therapy" targetRef="Task_OrderDiagnostics" />
      <bpmn:sequenceFlow id="Flow_t2" sourceRef="Task_OrderDiagnostics" targetRef="Task_RecordResults" />
      <bpmn:sequenceFlow id="Flow_t3" sourceRef="Task_RecordResults" targetRef="Task_PrescribeAbt" />
      <bpmn:sequenceFlow id="Flow_t4" sourceRef="Task_PrescribeAbt" targetRef="Task_PrescribeSymptomatic" />
      <bpmn:sequenceFlow id="Flow_t5" sourceRef="Task_PrescribeSymptomatic" targetRef="Task_CreateCarePlan" />
      <bpmn:sequenceFlow id="Flow_t6" sourceRef="Task_CreateCarePlan" targetRef="End_Therapy" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_Followup" name="Оценить контроль и исход">
      <bpmn:incoming>Flow_Top_Therapy_To_Followup</bpmn:incoming>
      <bpmn:outgoing>Flow_Top_Followup_Ok</bpmn:outgoing>
      <bpmn:startEvent id="Start_Followup" name="Начало">
        <bpmn:outgoing>Flow_f1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Task_Reassess" name="Оценить эффект терапии">
        <bpmn:incoming>Flow_f1</bpmn:incoming>
        <bpmn:outgoing>Flow_f2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="Gateway_AbtEffect" name="Есть эффект?">
        <bpmn:incoming>Flow_f2</bpmn:incoming>
        <bpmn:outgoing>Flow_f3</bpmn:outgoing>
        <bpmn:outgoing>Flow_f4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="End_Followup_NoEffect" name="Нет эффекта терапии">
        <bpmn:incoming>Flow_f4</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrDef_NoEffect" errorRef="Error_NoAbtEffect" />
      </bpmn:endEvent>
      <bpmn:task id="Task_Followup" name="Провести контрольный визит">
        <bpmn:incoming>Flow_f3</bpmn:incoming>
        <bpmn:outgoing>Flow_f5</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="Gateway_Goal" name="Цель достигнута?">
        <bpmn:incoming>Flow_f5</bpmn:incoming>
        <bpmn:outgoing>Flow_f6</bpmn:outgoing>
        <bpmn:outgoing>Flow_f7</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="End_Followup_Adjust" name="Скорректировать лечение">
        <bpmn:incoming>Flow_f7</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrDef_Adjust" errorRef="Error_AdjustTherapy" />
      </bpmn:endEvent>
      <bpmn:task id="Task_ScheduleRepeatCxr" name="Назначить контрольную рентгенографию">
        <bpmn:incoming>Flow_f6</bpmn:incoming>
        <bpmn:outgoing>Flow_f8</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Task_CloseEpisode" name="Закрыть эпизод">
        <bpmn:incoming>Flow_f8</bpmn:incoming>
        <bpmn:outgoing>Flow_f9</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="End_Followup_Ok" name="Эпизод завершён">
        <bpmn:incoming>Flow_f9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_f1" sourceRef="Start_Followup" targetRef="Task_Reassess" />
      <bpmn:sequenceFlow id="Flow_f2" sourceRef="Task_Reassess" targetRef="Gateway_AbtEffect" />
      <bpmn:sequenceFlow id="Flow_f3" name="да" sourceRef="Gateway_AbtEffect" targetRef="Task_Followup" />
      <bpmn:sequenceFlow id="Flow_f4" name="нет" sourceRef="Gateway_AbtEffect" targetRef="End_Followup_NoEffect" />
      <bpmn:sequenceFlow id="Flow_f5" sourceRef="Task_Followup" targetRef="Gateway_Goal" />
      <bpmn:sequenceFlow id="Flow_f6" name="да" sourceRef="Gateway_Goal" targetRef="Task_ScheduleRepeatCxr" />
      <bpmn:sequenceFlow id="Flow_f7" name="нет" sourceRef="Gateway_Goal" targetRef="End_Followup_Adjust" />
      <bpmn:sequenceFlow id="Flow_f8" sourceRef="Task_ScheduleRepeatCxr" targetRef="Task_CloseEpisode" />
      <bpmn:sequenceFlow id="Flow_f9" sourceRef="Task_CloseEpisode" targetRef="End_Followup_Ok" />
      <bpmn:textAnnotation id="Annotation_P15">
        <bpmn:text>КП №768, п.15</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Assoc_P15" sourceRef="Gateway_AbtEffect" targetRef="Annotation_P15" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Boundary_NoEffect" name="Нет эффекта" attachedToRef="SubProcess_Followup">
      <bpmn:outgoing>Flow_Top_NoEffect_To_Decide</bpmn:outgoing>
      <bpmn:errorEventDefinition id="BoundErr_NoEffect" errorRef="Error_NoAbtEffect" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_Adjust" name="Скорректировать лечение" attachedToRef="SubProcess_Followup">
      <bpmn:outgoing>Flow_Top_Adjust_To_Therapy</bpmn:outgoing>
      <bpmn:errorEventDefinition id="BoundErr_Adjust" errorRef="Error_AdjustTherapy" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_NoEffectNext" name="Нет эффекта — что дальше?">
      <bpmn:incoming>Flow_Top_NoEffect_To_Decide</bpmn:incoming>
      <bpmn:outgoing>Flow_Top_NoEffect_Hospital</bpmn:outgoing>
      <bpmn:outgoing>Flow_Top_NoEffect_Retreatment</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Recovered" name="Выздоровление достигнуто">
      <bpmn:incoming>Flow_Top_Followup_Ok</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Top_Start_Primary" sourceRef="Start_Complaint" targetRef="SubProcess_PrimaryVisit" />
    <bpmn:sequenceFlow id="Flow_Top_Primary_To_Hosp" sourceRef="SubProcess_PrimaryVisit" targetRef="Gateway_Hospitalization" />
    <bpmn:sequenceFlow id="Flow_Top_Hosp_Yes" name="да" sourceRef="Gateway_Hospitalization" targetRef="Gateway_HospitalMerge" />
    <bpmn:sequenceFlow id="Flow_Top_Hosp_No" name="нет" sourceRef="Gateway_Hospitalization" targetRef="Gateway_TherapyEntry" />
    <bpmn:sequenceFlow id="Flow_Top_To_Hospital_End" sourceRef="Gateway_HospitalMerge" targetRef="End_Hospitalized" />
    <bpmn:sequenceFlow id="Flow_Top_To_Therapy" sourceRef="Gateway_TherapyEntry" targetRef="SubProcess_Therapy" />
    <bpmn:sequenceFlow id="Flow_Top_Therapy_To_Followup" sourceRef="SubProcess_Therapy" targetRef="SubProcess_Followup" />
    <bpmn:sequenceFlow id="Flow_Top_Followup_Ok" sourceRef="SubProcess_Followup" targetRef="End_Recovered" />
    <bpmn:sequenceFlow id="Flow_Top_NoEffect_To_Decide" sourceRef="Boundary_NoEffect" targetRef="Gateway_NoEffectNext" />
    <bpmn:sequenceFlow id="Flow_Top_NoEffect_Hospital" sourceRef="Gateway_NoEffectNext" targetRef="Gateway_HospitalMerge" />
    <bpmn:sequenceFlow id="Flow_Top_NoEffect_Retreatment" name="сменить лечение" sourceRef="Gateway_NoEffectNext" targetRef="Gateway_TherapyEntry" />
    <bpmn:sequenceFlow id="Flow_Top_Adjust_To_Therapy" sourceRef="Boundary_Adjust" targetRef="Gateway_TherapyEntry" />
    <bpmn:textAnnotation id="Annotation_P26">
      <bpmn:text>КП №768, п.26</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_P26" sourceRef="Gateway_Hospitalization" targetRef="Annotation_P26" />
    <bpmn:textAnnotation id="Annotation_P15_Top">
      <bpmn:text>КП №768, п.15</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_P15_Top" sourceRef="Gateway_NoEffectNext" targetRef="Annotation_P15_Top" />
  </bpmn:process>
