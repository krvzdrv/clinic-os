  <bpmndi:BPMNDiagram id="BPMNDiagram_Primary">
    <bpmndi:BPMNPlane id="BPMNPlane_Primary" bpmnElement="SubProcess_PrimaryVisit">
      <bpmndi:BPMNShape id="S_P_Start" bpmnElement="Start_Primary">
        <dc:Bounds x="160" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="159" y="138" width="39" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_P_Intake" bpmnElement="Task_Intake">
        <dc:Bounds x="240" y="80" width="130" height="80" />
      </bpmndi:BPMNShape>
