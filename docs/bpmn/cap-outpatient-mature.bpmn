<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_cap_outpatient" targetNamespace="http://clinic-os/processes/cap_outpatient" exporter="Camunda Modeler" exporterVersion="5.46.1">
  <bpmn:process id="cap_outpatient" name="Амбулаторное лечение внебольничной пневмонии (КП №768)" isExecutable="false">
    <bpmn:startEvent id="Start_Complaint" name="Старт: обращение">
      <bpmn:outgoing>Flow_s1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Intake" name="Приём обращения">
      <bpmn:incoming>Flow_s1</bpmn:incoming>
      <bpmn:outgoing>Flow_s2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_VitalsExam" name="Осмотр">
      <bpmn:incoming>Flow_s2</bpmn:incoming>
      <bpmn:outgoing>Flow_s3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SetDiagnosis" name="Диагноз ВП">
      <bpmn:incoming>Flow_s3</bpmn:incoming>
      <bpmn:outgoing>Flow_s4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AssessSeverity" name="Оценка тяжести">
      <bpmn:incoming>Flow_s4</bpmn:incoming>
      <bpmn:outgoing>Flow_s5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Hospitalization" name="Госпитализация?" default="Flow_s7">
      <bpmn:incoming>Flow_s5</bpmn:incoming>
      <bpmn:incoming>Flow_s15</bpmn:incoming>
      <bpmn:outgoing>Flow_s6</bpmn:outgoing>
      <bpmn:outgoing>Flow_s7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Hospitalized" name="В стационар">
      <bpmn:incoming>Flow_s6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_OrderDiagnostics" name="Обследование">
      <bpmn:incoming>Flow_s7</bpmn:incoming>
      <bpmn:outgoing>Flow_s8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RecordResults" name="Результаты обследования">
      <bpmn:incoming>Flow_s8</bpmn:incoming>
      <bpmn:outgoing>Flow_s9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PrescribeAbt" name="Антибактериальная терапия">
      <bpmn:incoming>Flow_s9</bpmn:incoming>
      <bpmn:incoming>Flow_s18</bpmn:incoming>
      <bpmn:outgoing>Flow_s10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PrescribeSymptomatic" name="Симптоматическая терапия">
      <bpmn:incoming>Flow_s10</bpmn:incoming>
      <bpmn:outgoing>Flow_s11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CreateCarePlan" name="План лечения">
      <bpmn:incoming>Flow_s11</bpmn:incoming>
      <bpmn:outgoing>Flow_s12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Reassess" name="Оценка эффекта терапии">
      <bpmn:incoming>Flow_s12</bpmn:incoming>
      <bpmn:outgoing>Flow_s13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_AbtEffect" name="Есть эффект?" default="Flow_s14">
      <bpmn:incoming>Flow_s13</bpmn:incoming>
      <bpmn:outgoing>Flow_s14</bpmn:outgoing>
      <bpmn:outgoing>Flow_s15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Followup" name="Контрольный визит">
      <bpmn:incoming>Flow_s14</bpmn:incoming>
      <bpmn:outgoing>Flow_s16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Goal" name="Цель достигнута?" default="Flow_s18">
      <bpmn:incoming>Flow_s16</bpmn:incoming>
      <bpmn:outgoing>Flow_s17</bpmn:outgoing>
      <bpmn:outgoing>Flow_s18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ScheduleRepeatCxr" name="Контрольная визуализация">
      <bpmn:incoming>Flow_s17</bpmn:incoming>
      <bpmn:outgoing>Flow_s19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CloseEpisode" name="Закрытие эпизода">
      <bpmn:incoming>Flow_s19</bpmn:incoming>
      <bpmn:outgoing>Flow_s20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Recovered" name="Выздоровление">
      <bpmn:incoming>Flow_s20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_s1" sourceRef="Start_Complaint" targetRef="Task_Intake" />
    <bpmn:sequenceFlow id="Flow_s2" sourceRef="Task_Intake" targetRef="Task_VitalsExam" />
    <bpmn:sequenceFlow id="Flow_s3" sourceRef="Task_VitalsExam" targetRef="Task_SetDiagnosis" />
    <bpmn:sequenceFlow id="Flow_s4" sourceRef="Task_SetDiagnosis" targetRef="Task_AssessSeverity" />
    <bpmn:sequenceFlow id="Flow_s5" sourceRef="Task_AssessSeverity" targetRef="Gateway_Hospitalization" />
    <bpmn:sequenceFlow id="Flow_s6" name="да" sourceRef="Gateway_Hospitalization" targetRef="End_Hospitalized" />
    <bpmn:sequenceFlow id="Flow_s7" name="нет" sourceRef="Gateway_Hospitalization" targetRef="Task_OrderDiagnostics" />
    <bpmn:sequenceFlow id="Flow_s8" sourceRef="Task_OrderDiagnostics" targetRef="Task_RecordResults" />
    <bpmn:sequenceFlow id="Flow_s9" sourceRef="Task_RecordResults" targetRef="Task_PrescribeAbt" />
    <bpmn:sequenceFlow id="Flow_s10" sourceRef="Task_PrescribeAbt" targetRef="Task_PrescribeSymptomatic" />
    <bpmn:sequenceFlow id="Flow_s11" sourceRef="Task_PrescribeSymptomatic" targetRef="Task_CreateCarePlan" />
    <bpmn:sequenceFlow id="Flow_s12" sourceRef="Task_CreateCarePlan" targetRef="Task_Reassess" />
    <bpmn:sequenceFlow id="Flow_s13" sourceRef="Task_Reassess" targetRef="Gateway_AbtEffect" />
    <bpmn:sequenceFlow id="Flow_s14" name="да" sourceRef="Gateway_AbtEffect" targetRef="Task_Followup" />
    <bpmn:sequenceFlow id="Flow_s15" name="нет" sourceRef="Gateway_AbtEffect" targetRef="Gateway_Hospitalization" />
    <bpmn:sequenceFlow id="Flow_s16" sourceRef="Task_Followup" targetRef="Gateway_Goal" />
    <bpmn:sequenceFlow id="Flow_s17" name="да" sourceRef="Gateway_Goal" targetRef="Task_ScheduleRepeatCxr" />
    <bpmn:sequenceFlow id="Flow_s18" name="нет" sourceRef="Gateway_Goal" targetRef="Task_PrescribeAbt" />
    <bpmn:sequenceFlow id="Flow_s19" sourceRef="Task_ScheduleRepeatCxr" targetRef="Task_CloseEpisode" />
    <bpmn:sequenceFlow id="Flow_s20" sourceRef="Task_CloseEpisode" targetRef="End_Recovered" />
    <bpmn:textAnnotation id="Annotation_P26">
      <bpmn:text>КП №768, п.26</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_P26" sourceRef="Gateway_Hospitalization" targetRef="Annotation_P26" />
    <bpmn:textAnnotation id="Annotation_P15">
      <bpmn:text>КП №768, п.15</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_P15" sourceRef="Gateway_AbtEffect" targetRef="Annotation_P15" />
    <bpmn:textAnnotation id="Annotation_Version">
      <bpmn:text>Версия: 2026-07-25. Бизнес-процесс (не инструкция). Сверка с КП №768 — через YAML и аннотации у шлюзов.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Version" sourceRef="Start_Complaint" targetRef="Annotation_Version" />
  </bpmn:process>
