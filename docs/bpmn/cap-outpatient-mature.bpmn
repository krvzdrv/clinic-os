<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_cap_outpatient" targetNamespace="http://clinic-os/processes/cap_outpatient">
  <bpmn:process id="cap_outpatient" name="Амбулаторное лечение ВП (взрослые, КП МЗ РБ №768)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_out">
      <bpmn:lane id="Lane_intake" name="Intake">
        <bpmn:flowNodeRef>Task_Intake</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_nursing" name="Nursing">
        <bpmn:flowNodeRef>Task_VitalsExam</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_cds" name="CDS">
        <bpmn:flowNodeRef>Task_AssessSeverity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reassess</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_clinician" name="Clinician">
        <bpmn:flowNodeRef>Gateway_Hospitalization</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderDiagnostics</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetDiagnosis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrescribeAbt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrescribeSymptomatic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateCarePlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Followup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ScheduleRepeatCxr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_laboratory" name="Laboratory">
        <bpmn:flowNodeRef>Task_RecordResults</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_system" name="System">
        <bpmn:flowNodeRef>Task_CloseEpisode</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Complaint" name="Start: обращение"></bpmn:startEvent>
    <bpmn:task id="Task_Intake" name="Task_Intake — приём, жалоба"></bpmn:task>
    <bpmn:task id="Task_VitalsExam" name="Task_VitalsExam — t, SpO2, ЧД, ЧСС, осмотр"></bpmn:task>
    <bpmn:task id="Task_AssessSeverity" name="Task_AssessSeverity — класс тяжести (п.6.3)"></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Hospitalization" name="Gateway_Hospitalization (п.26)"></bpmn:exclusiveGateway>
    <bpmn:task id="Task_OrderDiagnostics" name="Task_OrderDiagnostics — ОАК, СРБ, R-графия"></bpmn:task>
    <bpmn:task id="Task_RecordResults" name="Task_RecordResults — WBC, CRP, CXR"></bpmn:task>
    <bpmn:task id="Task_SetDiagnosis" name="Task_SetDiagnosis — condition ВП"></bpmn:task>
    <bpmn:task id="Task_PrescribeAbt" name="Task_PrescribeAbt — АБТ per os (п.16-21)"></bpmn:task>
    <bpmn:task id="Task_PrescribeSymptomatic" name="Task_PrescribeSymptomatic — п.40-42"></bpmn:task>
    <bpmn:task id="Task_CreateCarePlan" name="Task_CreateCarePlan — план + цель"></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_AbtEffect" name="Gateway_AbtEffect — 48-72 ч (п.15, п.30)"></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Reassess" name="Task_Reassess — оценка эффективности АБТ"></bpmn:task>
    <bpmn:task id="Task_Followup" name="Task_Followup — контроль, оценка цели"></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Goal" name="Gateway_Goal — achieved?"></bpmn:exclusiveGateway>
    <bpmn:task id="Task_ScheduleRepeatCxr" name="Task_ScheduleRepeatCxr — 4-6 нед"></bpmn:task>
    <bpmn:task id="Task_CloseEpisode" name="Task_CloseEpisode — recovered"></bpmn:task>
    <bpmn:endEvent id="End_Recovered" name="End_Recovered"></bpmn:endEvent>
    <bpmn:endEvent id="End_Hospitalized" name="End_Hospitalized → cap_inpatient"></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_s1" sourceRef="Start_Complaint" targetRef="Task_Intake"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_s2" sourceRef="Task_Intake" targetRef="Task_VitalsExam"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_s3" sourceRef="Task_VitalsExam" targetRef="Task_AssessSeverity"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_s4" sourceRef="Task_AssessSeverity" targetRef="Gateway_Hospitalization"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_s5" name="показания" sourceRef="Gateway_Hospitalization" targetRef="End_Hospitalized"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_s6" name="нет показаний" sourceRef="Gateway_Hospitalization" targetRef="Task_OrderDiagnostics"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_s7" sourceRef="Task_OrderDiagnostics" targetRef="Task_RecordResults"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_s8" sourceRef="Task_RecordResults" targetRef="Task_SetDiagnosis"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_s9" sourceRef="Task_SetDiagnosis" targetRef="Task_PrescribeAbt"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_s10" sourceRef="Task_SetDiagnosis" targetRef="Task_PrescribeSymptomatic"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_s11" sourceRef="Task_SetDiagnosis" targetRef="Task_CreateCarePlan"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_s12" sourceRef="Task_PrescribeAbt" targetRef="Task_Reassess"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_s13" sourceRef="Task_Reassess" targetRef="Gateway_AbtEffect"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_s14" name="нет эффекта" sourceRef="Gateway_AbtEffect" targetRef="Gateway_Hospitalization"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_s15" name="эффект" sourceRef="Gateway_AbtEffect" targetRef="Task_Followup"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_s16" sourceRef="Task_Followup" targetRef="Gateway_Goal"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_s17" name="не достигнута" sourceRef="Gateway_Goal" targetRef="Task_PrescribeAbt"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_s18" name="достигнута" sourceRef="Gateway_Goal" targetRef="Task_ScheduleRepeatCxr"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_s19" sourceRef="Task_ScheduleRepeatCxr" targetRef="Task_CloseEpisode"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_s20" sourceRef="Task_CloseEpisode" targetRef="End_Recovered"></bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_out">
    <bpmndi:BPMNPlane id="BPMNPlane_out" bpmnElement="cap_outpatient">
      <bpmndi:BPMNShape id="Shape_Lane_intake" bpmnElement="Lane_intake" isHorizontal="true"><dc:Bounds x="160" y="80" width="900" height="120"/><bpmndi:BPMNLabel/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_nursing" bpmnElement="Lane_nursing" isHorizontal="true"><dc:Bounds x="160" y="200" width="900" height="120"/><bpmndi:BPMNLabel/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_cds" bpmnElement="Lane_cds" isHorizontal="true"><dc:Bounds x="160" y="320" width="900" height="120"/><bpmndi:BPMNLabel/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_clinician" bpmnElement="Lane_clinician" isHorizontal="true"><dc:Bounds x="160" y="440" width="900" height="160"/><bpmndi:BPMNLabel/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_laboratory" bpmnElement="Lane_laboratory" isHorizontal="true"><dc:Bounds x="160" y="600" width="900" height="120"/><bpmndi:BPMNLabel/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_system" bpmnElement="Lane_system" isHorizontal="true"><dc:Bounds x="160" y="720" width="900" height="120"/><bpmndi:BPMNLabel/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start_Complaint"><dc:Bounds x="180" y="120" width="36" height="36"/><bpmndi:BPMNLabel/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Intake" bpmnElement="Task_Intake"><dc:Bounds x="240" y="112" width="100" height="52"/><bpmndi:BPMNLabel/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Vitals" bpmnElement="Task_VitalsExam"><dc:Bounds x="360" y="232" width="120" height="52"/><bpmndi:BPMNLabel/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Severity" bpmnElement="Task_AssessSeverity"><dc:Bounds x="500" y="352" width="120" height="52"/><bpmndi:BPMNLabel/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GwHosp" bpmnElement="Gateway_Hospitalization" isMarkerVisible="true"><dc:Bounds x="540" y="500" width="50" height="50"/><bpmndi:BPMNLabel/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_OrderDx" bpmnElement="Task_OrderDiagnostics"><dc:Bounds x="640" y="472" width="120" height="52"/><bpmndi:BPMNLabel/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Results" bpmnElement="Task_RecordResults"><dc:Bounds x="640" y="632" width="120" height="52"/><bpmndi:BPMNLabel/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Dx" bpmnElement="Task_SetDiagnosis"><dc:Bounds x="640" y="472" width="0" height="0"/><bpmndi:BPMNLabel/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Abt" bpmnElement="Task_PrescribeAbt"><dc:Bounds x="640" y="472" width="0" height="0"/><bpmndi:BPMNLabel/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_s1" bpmnElement="Flow_s1"><di:waypoint x="216" y="138"/><di:waypoint x="240" y="138"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_s2" bpmnElement="Flow_s2"><di:waypoint x="340" y="138"/><di:waypoint x="360" y="258"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_s3" bpmnElement="Flow_s3"><di:waypoint x="480" y="258"/><di:waypoint x="500" y="378"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_s4" bpmnElement="Flow_s4"><di:waypoint x="620" y="378"/><di:waypoint x="565" y="500"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_s5" bpmnElement="Flow_s5"><di:waypoint x="540" y="525"/><di:waypoint x="540" y="560"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_s6" bpmnElement="Flow_s6"><di:waypoint x="590" y="525"/><di:waypoint x="640" y="498"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
