      <bpmndi:BPMNEdge id="Ce6" bpmnElement="Flow_c6">
        <di:waypoint x="570" y="200" />
        <di:waypoint x="660" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="595" y="178" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ce7" bpmnElement="Flow_c7">
