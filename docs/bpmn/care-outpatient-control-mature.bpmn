        <di:waypoint x="660" y="283" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="584.0" y="307.0" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ce8" bpmnElement="Flow_c8">
        <di:waypoint x="570" y="345" />
        <di:waypoint x="570" y="393" />
        <di:waypoint x="660" y="393" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="584.0" y="362.0" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ce9" bpmnElement="Flow_c9">
        <di:waypoint x="685" y="175" />
        <di:waypoint x="685" y="110" />
        <di:waypoint x="800" y="110" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="699.0" y="135.5" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ce10" bpmnElement="Flow_c10">
        <di:waypoint x="710" y="200" />
        <di:waypoint x="800" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="740" y="178" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ce11" bpmnElement="Flow_c11">
        <di:waypoint x="960" y="110" />
        <di:waypoint x="1040" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ce12" bpmnElement="Flow_c12">
        <di:waypoint x="980" y="200" />
        <di:waypoint x="1040" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CeAA" bpmnElement="Assoc_AfterControl">
        <di:waypoint x="1058" y="218" />
        <di:waypoint x="1058" y="280" />
        <di:waypoint x="1100" y="320" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
