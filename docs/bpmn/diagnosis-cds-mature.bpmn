<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_diagnosis_cds"
                  targetNamespace="http://clinic-os/processes/diagnosis_cds"
                  exporter="Camunda Modeler" exporterVersion="5.46.1">

  <bpmn:process id="diagnosis_cds" name="Поставить диагноз, проверить назначение, госпитализировать" isExecutable="false">

    <bpmn:startEvent id="Start_DC" name="Жалобы и осмотр записаны">
      <bpmn:outgoing>Flow_S1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:subProcess id="SP_Dx" name="Поставить диагноз и подключить протокол">
      <bpmn:incoming>Flow_S1</bpmn:incoming>
      <bpmn:outgoing>Flow_S2</bpmn:outgoing>

      <bpmn:startEvent id="Start_DxS" name="Начало"><bpmn:outgoing>Flow_dx1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:exclusiveGateway id="Gateway_LoopMerge" name="">
        <bpmn:incoming>Flow_dx1</bpmn:incoming>
        <bpmn:incoming>Flow_dx8</bpmn:incoming>
        <bpmn:outgoing>Flow_dx0</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="Task_SetDx" name="Поставить диагноз">
        <bpmn:incoming>Flow_dx0</bpmn:incoming>
        <bpmn:outgoing>Flow_dx2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="Gateway_Proto" name="Есть клинический протокол по этому диагнозу?">
        <bpmn:incoming>Flow_dx2</bpmn:incoming>
        <bpmn:outgoing>Flow_dx3</bpmn:outgoing>
        <bpmn:outgoing>Flow_dx4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="Task_Attach" name="Подключить протокол к диагнозу">
        <bpmn:incoming>Flow_dx3</bpmn:incoming>
        <bpmn:outgoing>Flow_dx5</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="Gateway_Merge1" name="">
        <bpmn:incoming>Flow_dx4</bpmn:incoming>
        <bpmn:incoming>Flow_dx5</bpmn:incoming>
        <bpmn:outgoing>Flow_dx6</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="Gateway_More" name="Нужен ещё один диагноз?">
        <bpmn:incoming>Flow_dx6</bpmn:incoming>
        <bpmn:outgoing>Flow_dx7</bpmn:outgoing>
        <bpmn:outgoing>Flow_dx8</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="End_DxS" name="Диагноз установлен"><bpmn:incoming>Flow_dx7</bpmn:incoming></bpmn:endEvent>

      <bpmn:sequenceFlow id="Flow_dx1" sourceRef="Start_DxS" targetRef="Gateway_LoopMerge" />
      <bpmn:sequenceFlow id="Flow_dx0" sourceRef="Gateway_LoopMerge" targetRef="Task_SetDx" />
      <bpmn:sequenceFlow id="Flow_dx2" sourceRef="Task_SetDx" targetRef="Gateway_Proto" />
      <bpmn:sequenceFlow id="Flow_dx3" name="да" sourceRef="Gateway_Proto" targetRef="Task_Attach" />
      <bpmn:sequenceFlow id="Flow_dx4" name="нет" sourceRef="Gateway_Proto" targetRef="Gateway_Merge1" />
      <bpmn:sequenceFlow id="Flow_dx5" sourceRef="Task_Attach" targetRef="Gateway_Merge1" />
      <bpmn:sequenceFlow id="Flow_dx6" sourceRef="Gateway_Merge1" targetRef="Gateway_More" />
      <bpmn:sequenceFlow id="Flow_dx7" name="нет" sourceRef="Gateway_More" targetRef="End_DxS" />
      <bpmn:sequenceFlow id="Flow_dx8" name="да" sourceRef="Gateway_More" targetRef="Gateway_LoopMerge" />

      <bpmn:textAnnotation id="Ann_Provenance">
        <bpmn:text>Диагноз по результату — кнопка «Диагноз» рядом с результатом анализа/снимка; новая запись подписывается «по результату: …» (провенанс)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Assoc_Provenance" sourceRef="Task_SetDx" targetRef="Ann_Provenance" />
      <bpmn:textAnnotation id="Ann_MultiProto">
        <bpmn:text>Может быть несколько протоколов одновременно (напр. ВП + анемия) — каждый со своей карточкой и проверкой</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Assoc_MultiProto" sourceRef="Task_Attach" targetRef="Ann_MultiProto" />
    </bpmn:subProcess>

    <bpmn:subProcess id="SP_Order" name="Назначить лечение и проверить">
      <bpmn:incoming>Flow_S2</bpmn:incoming>
      <bpmn:outgoing>Flow_S3</bpmn:outgoing>

      <bpmn:startEvent id="Start_OrdS" name="Начало"><bpmn:outgoing>Flow_o1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Task_Prescribe" name="Назначить лечение">
        <bpmn:incoming>Flow_o1</bpmn:incoming>
        <bpmn:outgoing>Flow_o2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="Gateway_Hard" name="Есть жёсткое противопоказание?">
        <bpmn:incoming>Flow_o2</bpmn:incoming>
        <bpmn:outgoing>Flow_o3</bpmn:outgoing>
        <bpmn:outgoing>Flow_o4</bpmn:outgoing>
      </bpmn:exclusiveGateway>

      <bpmn:exclusiveGateway id="Gateway_HardAck" name="Назначить несмотря на риск?">
        <bpmn:incoming>Flow_o3</bpmn:incoming>
        <bpmn:outgoing>Flow_o5</bpmn:outgoing>
        <bpmn:outgoing>Flow_o6</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="End_NotSavedH" name="Не сохранено — ждём решения врача"><bpmn:incoming>Flow_o5</bpmn:incoming></bpmn:endEvent>
      <bpmn:exclusiveGateway id="Gateway_HardReason" name="Указана письменная причина?">
        <bpmn:incoming>Flow_o6</bpmn:incoming>
        <bpmn:outgoing>Flow_o7</bpmn:outgoing>
        <bpmn:outgoing>Flow_o8</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="End_BlockedH" name="Не сохранено — нужна письменная причина"><bpmn:incoming>Flow_o7</bpmn:incoming></bpmn:endEvent>
      <bpmn:task id="Task_SaveHard" name="Сохранить назначение осознанно (жёсткое предупреждение)">
        <bpmn:incoming>Flow_o8</bpmn:incoming>
        <bpmn:outgoing>Flow_o15</bpmn:outgoing>
      </bpmn:task>

      <bpmn:exclusiveGateway id="Gateway_Soft" name="Назначение не первой линии по протоколу?">
        <bpmn:incoming>Flow_o4</bpmn:incoming>
        <bpmn:outgoing>Flow_o9</bpmn:outgoing>
        <bpmn:outgoing>Flow_o10</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="Gateway_SoftAck" name="Подтверждено осознанное назначение?">
        <bpmn:incoming>Flow_o9</bpmn:incoming>
        <bpmn:outgoing>Flow_o11</bpmn:outgoing>
        <bpmn:outgoing>Flow_o12</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="End_NotSavedS" name="Не сохранено — ждём решения врача"><bpmn:incoming>Flow_o11</bpmn:incoming></bpmn:endEvent>
      <bpmn:exclusiveGateway id="Gateway_SoftReason" name="Указана письменная причина?">
        <bpmn:incoming>Flow_o12</bpmn:incoming>
        <bpmn:outgoing>Flow_o13</bpmn:outgoing>
        <bpmn:outgoing>Flow_o14</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="End_BlockedS" name="Не сохранено — нужна письменная причина"><bpmn:incoming>Flow_o13</bpmn:incoming></bpmn:endEvent>
      <bpmn:task id="Task_SaveSoft" name="Сохранить назначение осознанно (не первая линия)">
        <bpmn:incoming>Flow_o14</bpmn:incoming>
        <bpmn:outgoing>Flow_o16</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Task_SaveClean" name="Сохранить назначение">
        <bpmn:incoming>Flow_o10</bpmn:incoming>
        <bpmn:outgoing>Flow_o17</bpmn:outgoing>
      </bpmn:task>

      <bpmn:exclusiveGateway id="Gateway_MergeSave" name="">
        <bpmn:incoming>Flow_o15</bpmn:incoming>
        <bpmn:incoming>Flow_o16</bpmn:incoming>
        <bpmn:incoming>Flow_o17</bpmn:incoming>
        <bpmn:outgoing>Flow_o18</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="End_OrdS" name="Назначение сохранено"><bpmn:incoming>Flow_o18</bpmn:incoming></bpmn:endEvent>

      <bpmn:sequenceFlow id="Flow_o1" sourceRef="Start_OrdS" targetRef="Task_Prescribe" />
      <bpmn:sequenceFlow id="Flow_o2" sourceRef="Task_Prescribe" targetRef="Gateway_Hard" />
      <bpmn:sequenceFlow id="Flow_o3" name="да" sourceRef="Gateway_Hard" targetRef="Gateway_HardAck" />
      <bpmn:sequenceFlow id="Flow_o4" name="нет" sourceRef="Gateway_Hard" targetRef="Gateway_Soft" />
      <bpmn:sequenceFlow id="Flow_o5" name="нет" sourceRef="Gateway_HardAck" targetRef="End_NotSavedH" />
      <bpmn:sequenceFlow id="Flow_o6" name="да" sourceRef="Gateway_HardAck" targetRef="Gateway_HardReason" />
      <bpmn:sequenceFlow id="Flow_o7" name="нет" sourceRef="Gateway_HardReason" targetRef="End_BlockedH" />
      <bpmn:sequenceFlow id="Flow_o8" name="да" sourceRef="Gateway_HardReason" targetRef="Task_SaveHard" />
      <bpmn:sequenceFlow id="Flow_o9" name="да" sourceRef="Gateway_Soft" targetRef="Gateway_SoftAck" />
      <bpmn:sequenceFlow id="Flow_o10" name="нет" sourceRef="Gateway_Soft" targetRef="Task_SaveClean" />
      <bpmn:sequenceFlow id="Flow_o11" name="нет" sourceRef="Gateway_SoftAck" targetRef="End_NotSavedS" />
      <bpmn:sequenceFlow id="Flow_o12" name="да" sourceRef="Gateway_SoftAck" targetRef="Gateway_SoftReason" />
      <bpmn:sequenceFlow id="Flow_o13" name="нет" sourceRef="Gateway_SoftReason" targetRef="End_BlockedS" />
      <bpmn:sequenceFlow id="Flow_o14" name="да" sourceRef="Gateway_SoftReason" targetRef="Task_SaveSoft" />
      <bpmn:sequenceFlow id="Flow_o15" sourceRef="Task_SaveHard" targetRef="Gateway_MergeSave" />
      <bpmn:sequenceFlow id="Flow_o16" sourceRef="Task_SaveSoft" targetRef="Gateway_MergeSave" />
      <bpmn:sequenceFlow id="Flow_o17" sourceRef="Task_SaveClean" targetRef="Gateway_MergeSave" />
      <bpmn:sequenceFlow id="Flow_o18" sourceRef="Gateway_MergeSave" targetRef="End_OrdS" />

      <bpmn:textAnnotation id="Ann_ReasonRule">
        <bpmn:text>Одного подтверждения недостаточно — нужна письменная причина, иначе назначение не сохранится</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Assoc_ReasonRule" sourceRef="Gateway_HardReason" targetRef="Ann_ReasonRule" />
      <bpmn:textAnnotation id="Ann_OverrideVisible">
        <bpmn:text>Осознанное назначение не делает картину приёма «зелёной» — остаётся видимая метка отклонения от протокола</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Assoc_OverrideVisible" sourceRef="Task_SaveSoft" targetRef="Ann_OverrideVisible" />
    </bpmn:subProcess>

    <bpmn:subProcess id="SP_Sev" name="Оценить тяжесть и госпитализировать">
      <bpmn:incoming>Flow_S3</bpmn:incoming>
      <bpmn:outgoing>Flow_S4</bpmn:outgoing>

      <bpmn:startEvent id="Start_SevS" name="Начало"><bpmn:outgoing>Flow_sv1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:exclusiveGateway id="Gateway_NeedInp" name="Нужна госпитализация?">
        <bpmn:incoming>Flow_sv1</bpmn:incoming>
        <bpmn:outgoing>Flow_sv2</bpmn:outgoing>
        <bpmn:outgoing>Flow_sv3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="Task_Admit" name="Госпитализировать">
        <bpmn:incoming>Flow_sv2</bpmn:incoming>
        <bpmn:outgoing>Flow_sv4</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="Gateway_MergeSev" name="">
        <bpmn:incoming>Flow_sv3</bpmn:incoming>
        <bpmn:incoming>Flow_sv4</bpmn:incoming>
        <bpmn:outgoing>Flow_sv5</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="End_SevS" name="Приём продолжается"><bpmn:incoming>Flow_sv5</bpmn:incoming></bpmn:endEvent>

      <bpmn:sequenceFlow id="Flow_sv1" sourceRef="Start_SevS" targetRef="Gateway_NeedInp" />
      <bpmn:sequenceFlow id="Flow_sv2" name="да" sourceRef="Gateway_NeedInp" targetRef="Task_Admit" />
      <bpmn:sequenceFlow id="Flow_sv3" name="нет" sourceRef="Gateway_NeedInp" targetRef="Gateway_MergeSev" />
      <bpmn:sequenceFlow id="Flow_sv4" sourceRef="Task_Admit" targetRef="Gateway_MergeSev" />
      <bpmn:sequenceFlow id="Flow_sv5" sourceRef="Gateway_MergeSev" targetRef="End_SevS" />

      <bpmn:textAnnotation id="Ann_Continuous">
        <bpmn:text>Пересчитывается непрерывно из данных осмотра — не отдельной кнопкой «оценить тяжесть»</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Assoc_Continuous" sourceRef="Gateway_NeedInp" targetRef="Ann_Continuous" />
      <bpmn:textAnnotation id="Ann_IcuGap">
        <bpmn:text>Запланировано, не готово: перевод в ОРИТ сейчас только текст подсказки — отдельного статуса «в ОРИТ» в системе нет</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Assoc_IcuGap" sourceRef="Task_Admit" targetRef="Ann_IcuGap" />
    </bpmn:subProcess>

    <bpmn:parallelGateway id="Gateway_Split">
      <bpmn:incoming>Flow_S4</bpmn:incoming>
      <bpmn:outgoing>Flow_S5</bpmn:outgoing>
      <bpmn:outgoing>Flow_S6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_Finish" name="Закрыть приём">
      <bpmn:incoming>Flow_S5</bpmn:incoming>
      <bpmn:outgoing>Flow_S7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Resolve" name="Разрешить диагноз">
      <bpmn:incoming>Flow_S6</bpmn:incoming>
      <bpmn:outgoing>Flow_S8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Finish" name="Приём закрыт"><bpmn:incoming>Flow_S7</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End_Resolve" name="Диагноз разрешён"><bpmn:incoming>Flow_S8</bpmn:incoming></bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_S1" sourceRef="Start_DC" targetRef="SP_Dx" />
    <bpmn:sequenceFlow id="Flow_S2" sourceRef="SP_Dx" targetRef="SP_Order" />
    <bpmn:sequenceFlow id="Flow_S3" sourceRef="SP_Order" targetRef="SP_Sev" />
    <bpmn:sequenceFlow id="Flow_S4" sourceRef="SP_Sev" targetRef="Gateway_Split" />
    <bpmn:sequenceFlow id="Flow_S5" sourceRef="Gateway_Split" targetRef="Task_Finish" />
    <bpmn:sequenceFlow id="Flow_S6" sourceRef="Gateway_Split" targetRef="Task_Resolve" />
    <bpmn:sequenceFlow id="Flow_S7" sourceRef="Task_Finish" targetRef="End_Finish" />
    <bpmn:sequenceFlow id="Flow_S8" sourceRef="Task_Resolve" targetRef="End_Resolve" />

    <bpmn:textAnnotation id="Ann_Independent">
      <bpmn:text>Оба действия — по отдельности, в любой момент приёма (не только в конце), не обязательно одновременно. STATUS_SEMANTICS.md §0: «Два переключателя»</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Independent" sourceRef="Gateway_Split" targetRef="Ann_Independent" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_diagnosis_cds">
    <bpmndi:BPMNPlane id="BPMNPlane_diagnosis_cds" bpmnElement="diagnosis_cds">
      <bpmndi:BPMNShape id="T_S" bpmnElement="Start_DC">
        <dc:Bounds x="80" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="45" y="225" width="110" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Dx" bpmnElement="SP_Dx">
        <dc:Bounds x="180" y="150" width="200" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Ord" bpmnElement="SP_Order">
        <dc:Bounds x="420" y="150" width="200" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Sev" bpmnElement="SP_Sev">
        <dc:Bounds x="660" y="150" width="200" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Split" bpmnElement="Gateway_Split">
        <dc:Bounds x="920" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Finish" bpmnElement="Task_Finish">
        <dc:Bounds x="1030" y="80" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Resolve" bpmnElement="Task_Resolve">
        <dc:Bounds x="1030" y="270" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_EFinish" bpmnElement="End_Finish">
        <dc:Bounds x="1240" y="98" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1215" y="141" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_EResolve" bpmnElement="End_Resolve">
        <dc:Bounds x="1250" y="288" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1225" y="331" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_AnnInd" bpmnElement="Ann_Independent">
        <dc:Bounds x="900" y="280" width="280" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="E_S1" bpmnElement="Flow_S1"><di:waypoint x="116" y="200" /><di:waypoint x="180" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_S2" bpmnElement="Flow_S2"><di:waypoint x="380" y="200" /><di:waypoint x="420" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_S3" bpmnElement="Flow_S3"><di:waypoint x="620" y="200" /><di:waypoint x="660" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_S4" bpmnElement="Flow_S4"><di:waypoint x="860" y="200" /><di:waypoint x="920" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_S5" bpmnElement="Flow_S5"><di:waypoint x="945" y="175" /><di:waypoint x="945" y="120" /><di:waypoint x="1030" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_S6" bpmnElement="Flow_S6"><di:waypoint x="945" y="225" /><di:waypoint x="945" y="310" /><di:waypoint x="1030" y="310" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_S7" bpmnElement="Flow_S7"><di:waypoint x="1190" y="120" /><di:waypoint x="1240" y="116" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_S8" bpmnElement="Flow_S8"><di:waypoint x="1200" y="310" /><di:waypoint x="1250" y="306" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="EA_Ind" bpmnElement="Assoc_Independent"><di:waypoint x="945" y="225" /><di:waypoint x="960" y="280" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Dx">
    <bpmndi:BPMNPlane id="BPMNPlane_Dx" bpmnElement="SP_Dx">
      <bpmndi:BPMNShape id="Dx_S" bpmnElement="Start_DxS"><dc:Bounds x="90" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Dx_LM" bpmnElement="Gateway_LoopMerge" isMarkerVisible="true"><dc:Bounds x="170" y="115" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Dx_T" bpmnElement="Task_SetDx"><dc:Bounds x="260" y="100" width="180" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Dx_G1" bpmnElement="Gateway_Proto" isMarkerVisible="true">
        <dc:Bounds x="500" y="115" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="475" y="65" width="100" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Dx_A" bpmnElement="Task_Attach"><dc:Bounds x="600" y="20" width="220" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Dx_M1" bpmnElement="Gateway_Merge1" isMarkerVisible="true"><dc:Bounds x="860" y="115" width="50" height="50" /></bpmndi:BPMNShape>
