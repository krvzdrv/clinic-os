<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_encounter_reason"
                  targetNamespace="http://clinic-os/processes/encounter_reason"
                  exporter="Camunda Modeler" exporterVersion="5.46.1">

  <bpmn:process id="encounter_reason" name="Повод приёма: новая жалоба или продолжение по диагнозу" isExecutable="false">

    <bpmn:startEvent id="Start_ER" name="Пациент обращается">
      <bpmn:outgoing>Flow_er1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:exclusiveGateway id="Gateway_HasActive" name="Есть у пациента активные диагнозы?">
      <bpmn:incoming>Flow_er1</bpmn:incoming>
      <bpmn:outgoing>Flow_er2</bpmn:outgoing>
      <bpmn:outgoing>Flow_er3</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gateway_Purpose" name="Приём — новая жалоба или продолжение лечения?">
      <bpmn:incoming>Flow_er2</bpmn:incoming>
      <bpmn:outgoing>Flow_er4</bpmn:outgoing>
      <bpmn:outgoing>Flow_er5</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gateway_MergeNew" name="">
      <bpmn:incoming>Flow_er3</bpmn:incoming>
      <bpmn:incoming>Flow_er5</bpmn:incoming>
      <bpmn:outgoing>Flow_er6</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_Continue" name="Открыть приём: отметить диагноз(ы), к которым он относится">
      <bpmn:incoming>Flow_er4</bpmn:incoming>
      <bpmn:outgoing>Flow_er7</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_NewComplaint" name="Открыть приём: новая жалоба">
      <bpmn:incoming>Flow_er6</bpmn:incoming>
      <bpmn:outgoing>Flow_er8</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_MergeAll" name="">
      <bpmn:incoming>Flow_er7</bpmn:incoming>
      <bpmn:incoming>Flow_er8</bpmn:incoming>
      <bpmn:outgoing>Flow_er9</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_Conduct" name="Вести приём: осмотр, диагноз, назначения, проверка">
      <bpmn:incoming>Flow_er9</bpmn:incoming>
      <bpmn:outgoing>Flow_er10</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_ER" name="Приём открыт — повод виден в карточке">
      <bpmn:incoming>Flow_er10</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_er1" sourceRef="Start_ER" targetRef="Gateway_HasActive" />
    <bpmn:sequenceFlow id="Flow_er2" name="да" sourceRef="Gateway_HasActive" targetRef="Gateway_Purpose" />
    <bpmn:sequenceFlow id="Flow_er3" name="нет" sourceRef="Gateway_HasActive" targetRef="Gateway_MergeNew" />
    <bpmn:sequenceFlow id="Flow_er4" name="продолжение лечения" sourceRef="Gateway_Purpose" targetRef="Task_Continue" />
    <bpmn:sequenceFlow id="Flow_er5" name="новая жалоба" sourceRef="Gateway_Purpose" targetRef="Gateway_MergeNew" />
    <bpmn:sequenceFlow id="Flow_er6" sourceRef="Gateway_MergeNew" targetRef="Task_NewComplaint" />
    <bpmn:sequenceFlow id="Flow_er7" sourceRef="Task_Continue" targetRef="Gateway_MergeAll" />
    <bpmn:sequenceFlow id="Flow_er8" sourceRef="Task_NewComplaint" targetRef="Gateway_MergeAll" />
    <bpmn:sequenceFlow id="Flow_er9" sourceRef="Gateway_MergeAll" targetRef="Task_Conduct" />
    <bpmn:sequenceFlow id="Flow_er10" sourceRef="Task_Conduct" targetRef="End_ER" />

    <bpmn:textAnnotation id="Ann_NoReset">
      <bpmn:text>Отмечены диагнозы — повод приёма пишется сразу, до любого назначения. Можно отметить несколько: один приём — сразу про несколько проблем. Диагноз ставить заново не нужно.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_NoReset" sourceRef="Task_Continue" targetRef="Ann_NoReset" />

    <bpmn:textAnnotation id="Ann_LinkLater">
      <bpmn:text>Ничего не отмечено — обычная новая жалоба; диагноз свяжется с приёмом сам, когда врач его поставит внутри этого же приёма (см. отдельную схему приёма и диагноза).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_LinkLater" sourceRef="Task_NewComplaint" targetRef="Ann_LinkLater" />

    <bpmn:textAnnotation id="Ann_NoWipe">
      <bpmn:text>Дальше приём ведётся одинаково независимо от повода — ничего не стирается и не начинается «с нуля»: меняется только то, какой диагноз сразу виден как повод.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_NoWipe" sourceRef="Task_Conduct" targetRef="Ann_NoWipe" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_ER">
    <bpmndi:BPMNPlane id="BPMNPlane_ER" bpmnElement="encounter_reason">
      <bpmndi:BPMNShape id="ER_S" bpmnElement="Start_ER">
        <dc:Bounds x="60" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="40" y="165" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ER_G1" bpmnElement="Gateway_HasActive" isMarkerVisible="true">
        <dc:Bounds x="150" y="115" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="120" y="65" width="110" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ER_G2" bpmnElement="Gateway_Purpose" isMarkerVisible="true">
        <dc:Bounds x="280" y="115" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="255" y="55" width="100" height="53" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ER_GMN" bpmnElement="Gateway_MergeNew" isMarkerVisible="true">
        <dc:Bounds x="280" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ER_TC" bpmnElement="Task_Continue">
        <dc:Bounds x="380" y="100" width="200" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ER_TN" bpmnElement="Task_NewComplaint">
        <dc:Bounds x="380" y="210" width="200" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ER_GMA" bpmnElement="Gateway_MergeAll" isMarkerVisible="true">
        <dc:Bounds x="650" y="115" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ER_TD" bpmnElement="Task_Conduct">
        <dc:Bounds x="730" y="100" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ER_E" bpmnElement="End_ER">
        <dc:Bounds x="1010" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="980" y="165" width="100" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ER_AnnA" bpmnElement="Ann_NoReset"><dc:Bounds x="380" y="0" width="260" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ER_AnnB" bpmnElement="Ann_LinkLater"><dc:Bounds x="380" y="320" width="270" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ER_AnnC" bpmnElement="Ann_NoWipe"><dc:Bounds x="740" y="220" width="260" height="70" /></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="ER_E1" bpmnElement="Flow_er1"><di:waypoint x="96" y="140" /><di:waypoint x="150" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ER_E2" bpmnElement="Flow_er2"><di:waypoint x="200" y="140" /><di:waypoint x="280" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ER_E3" bpmnElement="Flow_er3"><di:waypoint x="175" y="165" /><di:waypoint x="175" y="250" /><di:waypoint x="280" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ER_E4" bpmnElement="Flow_er4"><di:waypoint x="330" y="140" /><di:waypoint x="380" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ER_E5" bpmnElement="Flow_er5"><di:waypoint x="305" y="165" /><di:waypoint x="305" y="225" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ER_E6" bpmnElement="Flow_er6"><di:waypoint x="330" y="250" /><di:waypoint x="380" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ER_E7" bpmnElement="Flow_er7"><di:waypoint x="580" y="140" /><di:waypoint x="650" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ER_E8" bpmnElement="Flow_er8"><di:waypoint x="580" y="250" /><di:waypoint x="675" y="250" /><di:waypoint x="675" y="165" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ER_E9" bpmnElement="Flow_er9"><di:waypoint x="700" y="140" /><di:waypoint x="730" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ER_E10" bpmnElement="Flow_er10"><di:waypoint x="950" y="140" /><di:waypoint x="1010" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ER_AA" bpmnElement="Assoc_NoReset"><di:waypoint x="480" y="100" /><di:waypoint x="480" y="80" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ER_AB" bpmnElement="Assoc_LinkLater"><di:waypoint x="480" y="290" /><di:waypoint x="480" y="320" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ER_AC" bpmnElement="Assoc_NoWipe"><di:waypoint x="840" y="180" /><di:waypoint x="840" y="220" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
