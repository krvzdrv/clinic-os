<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_care_outpatient"
                  targetNamespace="http://clinic-os/processes/care_outpatient"
                  exporter="Camunda Modeler" exporterVersion="5.46.1">

  <bpmn:process id="care_outpatient" name="Амбулаторный визит" isExecutable="false">

    <bpmn:startEvent id="Start_Visit" name="Обращение">
      <bpmn:outgoing>Flow_Start_To_Visit</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:subProcess id="SubProcess_Visit" name="Провести приём: анамнез, осмотр, диагноз">
      <bpmn:incoming>Flow_Start_To_Visit</bpmn:incoming>
      <bpmn:outgoing>Flow_Visit_Done</bpmn:outgoing>
      <bpmn:startEvent id="Start_VisitInner" name="Начало"><bpmn:outgoing>Flow_v1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Task_Complaint" name="Собрать жалобы и анамнез"><bpmn:incoming>Flow_v1</bpmn:incoming><bpmn:outgoing>Flow_v2</bpmn:outgoing></bpmn:task>
      <bpmn:task id="Task_Exam" name="Провести осмотр"><bpmn:incoming>Flow_v2</bpmn:incoming><bpmn:outgoing>Flow_v3</bpmn:outgoing></bpmn:task>
      <bpmn:task id="Task_Diagnosis" name="Поставить диагноз"><bpmn:incoming>Flow_v3</bpmn:incoming><bpmn:outgoing>Flow_v4</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="End_VisitInner" name="Диагноз установлен"><bpmn:incoming>Flow_v4</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_v1" sourceRef="Start_VisitInner" targetRef="Task_Complaint" />
      <bpmn:sequenceFlow id="Flow_v2" sourceRef="Task_Complaint" targetRef="Task_Exam" />
      <bpmn:sequenceFlow id="Flow_v3" sourceRef="Task_Exam" targetRef="Task_Diagnosis" />
      <bpmn:sequenceFlow id="Flow_v4" sourceRef="Task_Diagnosis" targetRef="End_VisitInner" />
      <bpmn:textAnnotation id="Ann_MultiDx">
        <bpmn:text>На одном приёме может быть несколько диагнозов — путь ведения общий</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Assoc_MultiDx" sourceRef="Task_Diagnosis" targetRef="Ann_MultiDx" />
    </bpmn:subProcess>

    <bpmn:exclusiveGateway id="Gateway_Setting" name="Где продолжать?">
      <bpmn:incoming>Flow_Visit_Done</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Hospital</bpmn:outgoing>
      <bpmn:outgoing>Flow_To_Referral</bpmn:outgoing>
      <bpmn:outgoing>Flow_StayHere</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Hospital" name="Направить в стационар"><bpmn:incoming>Flow_To_Hospital</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End_Referral" name="Направить к другому специалисту"><bpmn:incoming>Flow_To_Referral</bpmn:incoming></bpmn:endEvent>

    <bpmn:subProcess id="SubProcess_Workup" name="Провести обследование">
      <bpmn:incoming>Flow_StayHere</bpmn:incoming>
      <bpmn:outgoing>Flow_Workup_Done</bpmn:outgoing>
      <bpmn:startEvent id="Start_Workup" name="Начало"><bpmn:outgoing>Flow_w1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:exclusiveGateway id="Gateway_NeedLabs" name="Нужны исследования сейчас?">
        <bpmn:incoming>Flow_w1</bpmn:incoming>
        <bpmn:outgoing>Flow_w2</bpmn:outgoing>
        <bpmn:outgoing>Flow_w3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="Task_OrderStudies" name="Назначить исследования"><bpmn:incoming>Flow_w2</bpmn:incoming><bpmn:outgoing>Flow_w4</bpmn:outgoing></bpmn:task>
      <bpmn:task id="Task_GetResults" name="Получить результаты"><bpmn:incoming>Flow_w4</bpmn:incoming><bpmn:outgoing>Flow_w5</bpmn:outgoing></bpmn:task>
      <bpmn:exclusiveGateway id="Gateway_WorkupMerge" name="">
        <bpmn:incoming>Flow_w3</bpmn:incoming>
        <bpmn:incoming>Flow_w5</bpmn:incoming>
        <bpmn:outgoing>Flow_w6</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="End_Workup" name="Обследование завершено"><bpmn:incoming>Flow_w6</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_w1" sourceRef="Start_Workup" targetRef="Gateway_NeedLabs" />
      <bpmn:sequenceFlow id="Flow_w2" name="да" sourceRef="Gateway_NeedLabs" targetRef="Task_OrderStudies" />
      <bpmn:sequenceFlow id="Flow_w3" name="нет" sourceRef="Gateway_NeedLabs" targetRef="Gateway_WorkupMerge" />
      <bpmn:sequenceFlow id="Flow_w4" sourceRef="Task_OrderStudies" targetRef="Task_GetResults" />
      <bpmn:sequenceFlow id="Flow_w5" sourceRef="Task_GetResults" targetRef="Gateway_WorkupMerge" />
      <bpmn:sequenceFlow id="Flow_w6" sourceRef="Gateway_WorkupMerge" targetRef="End_Workup" />
    </bpmn:subProcess>

    <bpmn:subProcess id="SubProcess_TreatPlan" name="Назначить лечение и запланировать контроль">
      <bpmn:incoming>Flow_Workup_Done</bpmn:incoming>
      <bpmn:outgoing>Flow_Treat_Done</bpmn:outgoing>
      <bpmn:startEvent id="Start_Treat" name="Начало"><bpmn:outgoing>Flow_t1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:exclusiveGateway id="Gateway_TreatNow" name="Назначить лечение сейчас?">
        <bpmn:incoming>Flow_t1</bpmn:incoming>
        <bpmn:outgoing>Flow_t2</bpmn:outgoing>
        <bpmn:outgoing>Flow_t3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="Task_Prescribe" name="Назначить лечение"><bpmn:incoming>Flow_t2</bpmn:incoming><bpmn:outgoing>Flow_t4</bpmn:outgoing></bpmn:task>
      <bpmn:task id="Task_Observe" name="Продолжить наблюдение без назначения"><bpmn:incoming>Flow_t3</bpmn:incoming><bpmn:outgoing>Flow_t5</bpmn:outgoing></bpmn:task>
      <bpmn:exclusiveGateway id="Gateway_TreatMerge" name="">
        <bpmn:incoming>Flow_t4</bpmn:incoming>
        <bpmn:incoming>Flow_t5</bpmn:incoming>
        <bpmn:outgoing>Flow_t6</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="Task_PlanFollowup" name="Запланировать контроль"><bpmn:incoming>Flow_t6</bpmn:incoming><bpmn:outgoing>Flow_t7</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="End_Treat" name="Контроль запланирован"><bpmn:incoming>Flow_t7</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_t1" sourceRef="Start_Treat" targetRef="Gateway_TreatNow" />
      <bpmn:sequenceFlow id="Flow_t2" name="да" sourceRef="Gateway_TreatNow" targetRef="Task_Prescribe" />
      <bpmn:sequenceFlow id="Flow_t3" name="нет" sourceRef="Gateway_TreatNow" targetRef="Task_Observe" />
      <bpmn:sequenceFlow id="Flow_t4" sourceRef="Task_Prescribe" targetRef="Gateway_TreatMerge" />
      <bpmn:sequenceFlow id="Flow_t5" sourceRef="Task_Observe" targetRef="Gateway_TreatMerge" />
      <bpmn:sequenceFlow id="Flow_t6" sourceRef="Gateway_TreatMerge" targetRef="Task_PlanFollowup" />
      <bpmn:sequenceFlow id="Flow_t7" sourceRef="Task_PlanFollowup" targetRef="End_Treat" />
      <bpmn:textAnnotation id="Ann_ProtocolPrescribe">
        <bpmn:text>При назначении — сверка с активными клиническими протоколами по диагнозам</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Assoc_ProtocolPrescribe" sourceRef="Task_Prescribe" targetRef="Ann_ProtocolPrescribe" />
      <bpmn:textAnnotation id="Ann_PlanFollowup">
        <bpmn:text>Когда вернуться и на что смотреть — часть плана</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Assoc_PlanFollowup" sourceRef="Task_PlanFollowup" targetRef="Ann_PlanFollowup" />
    </bpmn:subProcess>

    <bpmn:endEvent id="End_NextVisit" name="До следующего визита">
      <bpmn:incoming>Flow_Treat_Done</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_To_Visit" sourceRef="Start_Visit" targetRef="SubProcess_Visit" />
    <bpmn:sequenceFlow id="Flow_Visit_Done" sourceRef="SubProcess_Visit" targetRef="Gateway_Setting" />
    <bpmn:sequenceFlow id="Flow_To_Hospital" name="стационар" sourceRef="Gateway_Setting" targetRef="End_Hospital" />
    <bpmn:sequenceFlow id="Flow_To_Referral" name="другой специалист" sourceRef="Gateway_Setting" targetRef="End_Referral" />
    <bpmn:sequenceFlow id="Flow_StayHere" name="здесь" sourceRef="Gateway_Setting" targetRef="SubProcess_Workup" />
    <bpmn:sequenceFlow id="Flow_Workup_Done" sourceRef="SubProcess_Workup" targetRef="SubProcess_TreatPlan" />
    <bpmn:sequenceFlow id="Flow_Treat_Done" sourceRef="SubProcess_TreatPlan" targetRef="End_NextVisit" />

    <bpmn:textAnnotation id="Ann_VisitOnce">
      <bpmn:text>Один визит без петель. Повторное обращение — снова этот старт. Контроль — отдельный процесс.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_VisitOnce" sourceRef="Start_Visit" targetRef="Ann_VisitOnce" />
    <bpmn:textAnnotation id="Ann_Next">
      <bpmn:text>Следующий визит: снова «Обращение». Решения на контроле — в отдельном процессе контроля.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Next" sourceRef="End_NextVisit" targetRef="Ann_Next" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_care_out">
    <bpmndi:BPMNPlane id="BPMNPlane_care_out" bpmnElement="care_outpatient">
      <bpmndi:BPMNShape id="T_S" bpmnElement="Start_Visit">
        <dc:Bounds x="80" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="45" y="225" width="110" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_V" bpmnElement="SubProcess_Visit">
        <dc:Bounds x="180" y="150" width="200" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_GS" bpmnElement="Gateway_Setting" isMarkerVisible="true">
        <dc:Bounds x="450" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="420" y="235" width="110" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_W" bpmnElement="SubProcess_Workup">
        <dc:Bounds x="570" y="150" width="160" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_T" bpmnElement="SubProcess_TreatPlan">
        <dc:Bounds x="790" y="150" width="200" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_E" bpmnElement="End_NextVisit">
        <dc:Bounds x="1060" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1000" y="225" width="160" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_EH" bpmnElement="End_Hospital">
        <dc:Bounds x="457" y="50" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="430" y="20" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_ER" bpmnElement="End_Referral">
        <dc:Bounds x="457" y="310" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="410" y="353" width="130" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_AV" bpmnElement="Ann_VisitOnce">
        <dc:Bounds x="80" y="0" width="420" height="45" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_AN" bpmnElement="Ann_Next">
        <dc:Bounds x="980" y="280" width="220" height="55" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E1" bpmnElement="Flow_Start_To_Visit">
        <di:waypoint x="116" y="200" />
        <di:waypoint x="180" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E2" bpmnElement="Flow_Visit_Done">
        <di:waypoint x="380" y="200" />
        <di:waypoint x="450" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E3" bpmnElement="Flow_StayHere">
        <di:waypoint x="500" y="200" />
        <di:waypoint x="570" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="515" y="178" width="35" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E4" bpmnElement="Flow_Workup_Done">
        <di:waypoint x="730" y="200" />
        <di:waypoint x="790" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E5" bpmnElement="Flow_Treat_Done">
        <di:waypoint x="990" y="200" />
        <di:waypoint x="1060" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E6" bpmnElement="Flow_To_Hospital">
        <di:waypoint x="475" y="175" />
        <di:waypoint x="475" y="86" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="485" y="120" width="55" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E7" bpmnElement="Flow_To_Referral">
        <di:waypoint x="475" y="225" />
        <di:waypoint x="475" y="310" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="485" y="255" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="EA1" bpmnElement="Assoc_VisitOnce">
        <di:waypoint x="98" y="182" />
        <di:waypoint x="98" y="45" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="EA2" bpmnElement="Assoc_Next">
        <di:waypoint x="1078" y="218" />
        <di:waypoint x="1078" y="280" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Visit">
    <bpmndi:BPMNPlane id="BPMNPlane_Visit" bpmnElement="SubProcess_Visit">
      <bpmndi:BPMNShape id="V_S" bpmnElement="Start_VisitInner">
        <dc:Bounds x="140" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="V_C" bpmnElement="Task_Complaint">
        <dc:Bounds x="220" y="100" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="V_E" bpmnElement="Task_Exam">
        <dc:Bounds x="410" y="100" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="V_D" bpmnElement="Task_Diagnosis">
        <dc:Bounds x="570" y="100" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="V_N" bpmnElement="End_VisitInner">
        <dc:Bounds x="800" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="770" y="165" width="100" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="V_A" bpmnElement="Ann_MultiDx">
        <dc:Bounds x="560" y="220" width="260" height="45" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Ve1" bpmnElement="Flow_v1">
        <di:waypoint x="176" y="140" />
        <di:waypoint x="220" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ve2" bpmnElement="Flow_v2">
        <di:waypoint x="370" y="140" />
        <di:waypoint x="410" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ve3" bpmnElement="Flow_v3">
        <di:waypoint x="530" y="140" />
        <di:waypoint x="570" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ve4" bpmnElement="Flow_v4">
        <di:waypoint x="740" y="140" />
        <di:waypoint x="800" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="VeA" bpmnElement="Assoc_MultiDx">
        <di:waypoint x="655" y="180" />
        <di:waypoint x="655" y="220" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Workup">
    <bpmndi:BPMNPlane id="BPMNPlane_Workup" bpmnElement="SubProcess_Workup">
      <bpmndi:BPMNShape id="W_S" bpmnElement="Start_Workup">
        <dc:Bounds x="140" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W_G" bpmnElement="Gateway_NeedLabs" isMarkerVisible="true">
        <dc:Bounds x="230" y="135" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="190" y="195" width="140" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W_O" bpmnElement="Task_OrderStudies">
        <dc:Bounds x="360" y="60" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W_R" bpmnElement="Task_GetResults">
        <dc:Bounds x="580" y="60" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W_M" bpmnElement="Gateway_WorkupMerge" isMarkerVisible="true">
        <dc:Bounds x="800" y="135" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W_E" bpmnElement="End_Workup">
        <dc:Bounds x="920" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="880" y="185" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="We1" bpmnElement="Flow_w1">
        <di:waypoint x="176" y="160" />
        <di:waypoint x="230" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="We2" bpmnElement="Flow_w2">
        <di:waypoint x="255" y="135" />
        <di:waypoint x="255" y="100" />
        <di:waypoint x="360" y="100" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="270" y="80" width="13" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="We3" bpmnElement="Flow_w3">
        <di:waypoint x="280" y="160" />
        <di:waypoint x="800" y="160" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="500" y="138" width="17" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="We4" bpmnElement="Flow_w4">
        <di:waypoint x="530" y="100" />
        <di:waypoint x="580" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="We5" bpmnElement="Flow_w5">
        <di:waypoint x="740" y="100" />
        <di:waypoint x="825" y="100" />
        <di:waypoint x="825" y="135" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="We6" bpmnElement="Flow_w6">
        <di:waypoint x="850" y="160" />
        <di:waypoint x="920" y="160" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Treat">
    <bpmndi:BPMNPlane id="BPMNPlane_Treat" bpmnElement="SubProcess_TreatPlan">
      <bpmndi:BPMNShape id="Tr_S" bpmnElement="Start_Treat">
        <dc:Bounds x="120" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Tr_G" bpmnElement="Gateway_TreatNow" isMarkerVisible="true">
        <dc:Bounds x="210" y="155" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="160" y="215" width="150" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Tr_P" bpmnElement="Task_Prescribe">
        <dc:Bounds x="340" y="60" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Tr_O" bpmnElement="Task_Observe">
        <dc:Bounds x="340" y="240" width="200" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Tr_M" bpmnElement="Gateway_TreatMerge" isMarkerVisible="true">
        <dc:Bounds x="600" y="155" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Tr_F" bpmnElement="Task_PlanFollowup">
