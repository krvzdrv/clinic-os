<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_ida_outpatient"
                  targetNamespace="http://clinic-os/processes/ida_outpatient"
                  exporter="Camunda Modeler" exporterVersion="5.46.1">
  <bpmn:error id="Error_NoIronEffect" name="Нет эффекта терапии железом" errorCode="NO_IRON_EFFECT" />

  <bpmn:process id="ida_outpatient" name="Лечение железодефицитной анемии (КП №23)" isExecutable="false">
    <bpmn:startEvent id="Start_Ida" name="Обращение с подозрением на анемию">
      <bpmn:outgoing>Flow_Top_Start</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:subProcess id="SubProcess_Confirm" name="Подтвердить диагноз и оценить тяжесть">
      <bpmn:incoming>Flow_Top_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_Top_Confirm_To_Hosp</bpmn:outgoing>
      <bpmn:startEvent id="Start_Confirm" name="Начало"><bpmn:outgoing>Flow_i1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Task_IdaAnamnesis" name="Собрать жалобы и анамнез"><bpmn:incoming>Flow_i1</bpmn:incoming><bpmn:outgoing>Flow_i2</bpmn:outgoing></bpmn:task>
      <bpmn:task id="Task_IdaExam" name="Провести осмотр"><bpmn:incoming>Flow_i2</bpmn:incoming><bpmn:outgoing>Flow_i3</bpmn:outgoing></bpmn:task>
      <bpmn:task id="Task_IdaDiagnosis" name="Поставить диагноз ЖДА"><bpmn:incoming>Flow_i3</bpmn:incoming><bpmn:outgoing>Flow_i4</bpmn:outgoing></bpmn:task>
      <bpmn:task id="Task_IdaSeverity" name="Оценить тяжесть по гемоглобину"><bpmn:incoming>Flow_i4</bpmn:incoming><bpmn:outgoing>Flow_i5</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="End_Confirm" name="Тяжесть определена"><bpmn:incoming>Flow_i5</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_i1" sourceRef="Start_Confirm" targetRef="Task_IdaAnamnesis" />
      <bpmn:sequenceFlow id="Flow_i2" sourceRef="Task_IdaAnamnesis" targetRef="Task_IdaExam" />
      <bpmn:sequenceFlow id="Flow_i3" sourceRef="Task_IdaExam" targetRef="Task_IdaDiagnosis" />
      <bpmn:sequenceFlow id="Flow_i4" sourceRef="Task_IdaDiagnosis" targetRef="Task_IdaSeverity" />
      <bpmn:sequenceFlow id="Flow_i5" sourceRef="Task_IdaSeverity" targetRef="End_Confirm" />
    </bpmn:subProcess>

    <bpmn:exclusiveGateway id="Gateway_IdaHospitalization" name="Нужна госпитализация или переливание?">
      <bpmn:incoming>Flow_Top_Confirm_To_Hosp</bpmn:incoming>
      <bpmn:outgoing>Flow_Top_Hosp_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Top_Hosp_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_IdaHospital" name="Направить в стационар"><bpmn:incoming>Flow_Top_Hosp_Yes</bpmn:incoming></bpmn:endEvent>

    <bpmn:subProcess id="SubProcess_IdaLabs" name="Провести обследование">
      <bpmn:incoming>Flow_Top_Hosp_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Top_Labs_To_Therapy</bpmn:outgoing>
      <bpmn:startEvent id="Start_Labs" name="Начало"><bpmn:outgoing>Flow_l1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Task_IdaOrderLabs" name="Назначить необходимые исследования"><bpmn:incoming>Flow_l1</bpmn:incoming><bpmn:outgoing>Flow_l2</bpmn:outgoing></bpmn:task>
      <bpmn:task id="Task_IdaRecordLabs" name="Получить результаты"><bpmn:incoming>Flow_l2</bpmn:incoming><bpmn:outgoing>Flow_l3</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="End_Labs" name="Обследование завершено"><bpmn:incoming>Flow_l3</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_l1" sourceRef="Start_Labs" targetRef="Task_IdaOrderLabs" />
      <bpmn:sequenceFlow id="Flow_l2" sourceRef="Task_IdaOrderLabs" targetRef="Task_IdaRecordLabs" />
      <bpmn:sequenceFlow id="Flow_l3" sourceRef="Task_IdaRecordLabs" targetRef="End_Labs" />
    </bpmn:subProcess>

    <bpmn:exclusiveGateway id="Gateway_TherapyEntry" name="">
      <bpmn:incoming>Flow_Top_Labs_To_Therapy</bpmn:incoming>
      <bpmn:incoming>Flow_Top_Retry_Therapy</bpmn:incoming>
      <bpmn:outgoing>Flow_Top_To_Therapy</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:subProcess id="SubProcess_IdaTherapy" name="Назначить терапию железом">
      <bpmn:incoming>Flow_Top_To_Therapy</bpmn:incoming>
      <bpmn:outgoing>Flow_Top_Therapy_To_Control</bpmn:outgoing>
      <bpmn:startEvent id="Start_Iron" name="Начало"><bpmn:outgoing>Flow_r1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:exclusiveGateway id="Gateway_OralIron" name="Можно железо внутрь?">
        <bpmn:incoming>Flow_r1</bpmn:incoming>
        <bpmn:outgoing>Flow_r2</bpmn:outgoing>
        <bpmn:outgoing>Flow_r3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="Task_IdaOralIron" name="Назначить железо внутрь"><bpmn:incoming>Flow_r3</bpmn:incoming><bpmn:outgoing>Flow_r4</bpmn:outgoing></bpmn:task>
      <bpmn:task id="Task_IdaIvIron" name="Назначить железо внутривенно"><bpmn:incoming>Flow_r2</bpmn:incoming><bpmn:outgoing>Flow_r5</bpmn:outgoing></bpmn:task>
      <bpmn:exclusiveGateway id="Gateway_IronMerge" name="">
        <bpmn:incoming>Flow_r4</bpmn:incoming>
        <bpmn:incoming>Flow_r5</bpmn:incoming>
        <bpmn:outgoing>Flow_r6</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="End_Iron" name="Терапия назначена"><bpmn:incoming>Flow_r6</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_r1" sourceRef="Start_Iron" targetRef="Gateway_OralIron" />
      <bpmn:sequenceFlow id="Flow_r2" name="нет" sourceRef="Gateway_OralIron" targetRef="Task_IdaIvIron" />
      <bpmn:sequenceFlow id="Flow_r3" name="да" sourceRef="Gateway_OralIron" targetRef="Task_IdaOralIron" />
      <bpmn:sequenceFlow id="Flow_r4" sourceRef="Task_IdaOralIron" targetRef="Gateway_IronMerge" />
      <bpmn:sequenceFlow id="Flow_r5" sourceRef="Task_IdaIvIron" targetRef="Gateway_IronMerge" />
      <bpmn:sequenceFlow id="Flow_r6" sourceRef="Gateway_IronMerge" targetRef="End_Iron" />
      <bpmn:textAnnotation id="Annotation_IdaRoute"><bpmn:text>КП №23: внутрь — первая линия; внутривенно — при нарушении всасывания, болезни ЖКТ, непереносимости</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_IdaRoute" sourceRef="Gateway_OralIron" targetRef="Annotation_IdaRoute" />
    </bpmn:subProcess>

    <bpmn:subProcess id="SubProcess_IdaControl" name="Оценить эффективность терапии">
      <bpmn:incoming>Flow_Top_Therapy_To_Control</bpmn:incoming>
      <bpmn:outgoing>Flow_Top_Control_Ok</bpmn:outgoing>
      <bpmn:startEvent id="Start_Ctrl" name="Начало"><bpmn:outgoing>Flow_k1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Task_IdaControlLabs" name="Назначить контрольные анализы"><bpmn:incoming>Flow_k1</bpmn:incoming><bpmn:outgoing>Flow_k2</bpmn:outgoing></bpmn:task>
      <bpmn:exclusiveGateway id="Gateway_IronEffect" name="Есть эффект?">
        <bpmn:incoming>Flow_k2</bpmn:incoming>
        <bpmn:outgoing>Flow_k3</bpmn:outgoing>
        <bpmn:outgoing>Flow_k4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="End_Ctrl_NoEffect" name="Нет эффекта терапии">
        <bpmn:incoming>Flow_k3</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrDef_NoIron" errorRef="Error_NoIronEffect" />
      </bpmn:endEvent>
      <bpmn:task id="Task_IdaClose" name="Закрыть эпизод — цель достигнута"><bpmn:incoming>Flow_k4</bpmn:incoming><bpmn:outgoing>Flow_k5</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="End_Ctrl_Ok" name="Эпизод завершён"><bpmn:incoming>Flow_k5</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_k1" sourceRef="Start_Ctrl" targetRef="Task_IdaControlLabs" />
      <bpmn:sequenceFlow id="Flow_k2" sourceRef="Task_IdaControlLabs" targetRef="Gateway_IronEffect" />
      <bpmn:sequenceFlow id="Flow_k3" name="нет" sourceRef="Gateway_IronEffect" targetRef="End_Ctrl_NoEffect" />
      <bpmn:sequenceFlow id="Flow_k4" name="да" sourceRef="Gateway_IronEffect" targetRef="Task_IdaClose" />
      <bpmn:sequenceFlow id="Flow_k5" sourceRef="Task_IdaClose" targetRef="End_Ctrl_Ok" />
    </bpmn:subProcess>

    <bpmn:boundaryEvent id="Boundary_NoIron" name="Нет эффекта" attachedToRef="SubProcess_IdaControl">
      <bpmn:outgoing>Flow_Top_Retry_Therapy</bpmn:outgoing>
      <bpmn:errorEventDefinition id="BoundErr_NoIron" errorRef="Error_NoIronEffect" />
    </bpmn:boundaryEvent>

    <bpmn:endEvent id="End_IdaRecovered" name="Эпизод завершён — цель достигнута"><bpmn:incoming>Flow_Top_Control_Ok</bpmn:incoming></bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Top_Start" sourceRef="Start_Ida" targetRef="SubProcess_Confirm" />
    <bpmn:sequenceFlow id="Flow_Top_Confirm_To_Hosp" sourceRef="SubProcess_Confirm" targetRef="Gateway_IdaHospitalization" />
    <bpmn:sequenceFlow id="Flow_Top_Hosp_Yes" name="да" sourceRef="Gateway_IdaHospitalization" targetRef="End_IdaHospital" />
    <bpmn:sequenceFlow id="Flow_Top_Hosp_No" name="нет" sourceRef="Gateway_IdaHospitalization" targetRef="SubProcess_IdaLabs" />
    <bpmn:sequenceFlow id="Flow_Top_Labs_To_Therapy" sourceRef="SubProcess_IdaLabs" targetRef="Gateway_TherapyEntry" />
    <bpmn:sequenceFlow id="Flow_Top_To_Therapy" sourceRef="Gateway_TherapyEntry" targetRef="SubProcess_IdaTherapy" />
    <bpmn:sequenceFlow id="Flow_Top_Therapy_To_Control" sourceRef="SubProcess_IdaTherapy" targetRef="SubProcess_IdaControl" />
    <bpmn:sequenceFlow id="Flow_Top_Control_Ok" sourceRef="SubProcess_IdaControl" targetRef="End_IdaRecovered" />
    <bpmn:sequenceFlow id="Flow_Top_Retry_Therapy" sourceRef="Boundary_NoIron" targetRef="Gateway_TherapyEntry" />

    <bpmn:textAnnotation id="Annotation_IdaHosp"><bpmn:text>КП №23: тяжёлая анемия или декомпенсация</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_IdaHosp" sourceRef="Gateway_IdaHospitalization" targetRef="Annotation_IdaHosp" />
    <bpmn:textAnnotation id="Annotation_Version">
      <bpmn:text>КП №23: железодефицитная анемия у взрослых. Верхний уровень — фазы; детали — внутри фаз.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Version" sourceRef="Start_Ida" targetRef="Annotation_Version" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_ida">
    <bpmndi:BPMNPlane id="BPMNPlane_ida" bpmnElement="ida_outpatient">
      <bpmndi:BPMNShape id="X_S" bpmnElement="Start_Ida">
