      <bpmndi:BPMNEdge id="ICe5" bpmnElement="Flow_i5">
        <di:waypoint x="980" y="140" />
        <di:waypoint x="1030" y="140" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

  <bpmndi:BPMNDiagram id="BPMNDiagram_IdaLabs">
    <bpmndi:BPMNPlane id="BPMNPlane_IdaLabs" bpmnElement="SubProcess_IdaLabs">
      <bpmndi:BPMNShape id="IL_S" bpmnElement="Start_Labs">
        <dc:Bounds x="160" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IL_O" bpmnElement="Task_IdaOrderLabs">
        <dc:Bounds x="240" y="100" width="200" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IL_R" bpmnElement="Task_IdaRecordLabs">
        <dc:Bounds x="490" y="100" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IL_E" bpmnElement="End_Labs">
        <dc:Bounds x="710" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="670" y="165" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ILe1" bpmnElement="Flow_l1">
        <di:waypoint x="196" y="140" />
        <di:waypoint x="240" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ILe2" bpmnElement="Flow_l2">
        <di:waypoint x="440" y="140" />
        <di:waypoint x="490" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ILe3" bpmnElement="Flow_l3">
        <di:waypoint x="650" y="140" />
        <di:waypoint x="710" y="140" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
