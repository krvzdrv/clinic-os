          <dc:Bounds x="468" y="383" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="X_L" bpmnElement="SubProcess_IdaLabs">
        <dc:Bounds x="600" y="180" width="180" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="X_TE" bpmnElement="Gateway_TherapyEntry" isMarkerVisible="true">
        <dc:Bounds x="795" y="205" width="50" height="50" />
      </bpmndi:BPMNShape>
