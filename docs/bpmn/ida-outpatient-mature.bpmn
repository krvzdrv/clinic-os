      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Xe8" bpmnElement="Flow_Top_Retry_Therapy">
        <di:waypoint x="1098" y="298" />
        <di:waypoint x="1098" y="380" />
        <di:waypoint x="820" y="380" />
        <di:waypoint x="820" y="255" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="XeA" bpmnElement="Assoc_IdaHosp">
        <di:waypoint x="505" y="205" />
        <di:waypoint x="505" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="XeV" bpmnElement="Assoc_Version">
        <di:waypoint x="138" y="212" />
        <di:waypoint x="138" y="90" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

  <bpmndi:BPMNDiagram id="BPMNDiagram_IdaConfirm">
    <bpmndi:BPMNPlane id="BPMNPlane_IdaConfirm" bpmnElement="SubProcess_Confirm">
      <bpmndi:BPMNShape id="IC_S" bpmnElement="Start_Confirm">
        <dc:Bounds x="140" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IC_A" bpmnElement="Task_IdaAnamnesis">
        <dc:Bounds x="220" y="100" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IC_E" bpmnElement="Task_IdaExam">
        <dc:Bounds x="400" y="100" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IC_D" bpmnElement="Task_IdaDiagnosis">
        <dc:Bounds x="560" y="100" width="200" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IC_V" bpmnElement="Task_IdaSeverity">
        <dc:Bounds x="800" y="100" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IC_N" bpmnElement="End_Confirm">
        <dc:Bounds x="1030" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1000" y="165" width="100" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ICe1" bpmnElement="Flow_i1">
        <di:waypoint x="176" y="140" />
        <di:waypoint x="220" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ICe2" bpmnElement="Flow_i2">
        <di:waypoint x="360" y="140" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ICe3" bpmnElement="Flow_i3">
        <di:waypoint x="520" y="140" />
        <di:waypoint x="560" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ICe4" bpmnElement="Flow_i4">
