        <dc:Bounds x="1370" y="212" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1280" y="255" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="X_AH" bpmnElement="Annotation_IdaHosp">
        <dc:Bounds x="430" y="100" width="200" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="X_AV" bpmnElement="Annotation_Version">
        <dc:Bounds x="120" y="40" width="400" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Xe1" bpmnElement="Flow_Top_Start">
        <di:waypoint x="156" y="230" />
        <di:waypoint x="220" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Xe2" bpmnElement="Flow_Top_Confirm_To_Hosp">
        <di:waypoint x="420" y="230" />
        <di:waypoint x="480" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Xe3" bpmnElement="Flow_Top_Hosp_Yes">
        <di:waypoint x="505" y="255" />
        <di:waypoint x="505" y="340" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="513" y="290" width="13" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Xe4" bpmnElement="Flow_Top_Hosp_No">
